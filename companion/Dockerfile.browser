FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends chromium fonts-noto-cjk && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN npm init -y && npm install --ignore-scripts --omit=dev playwright-core@1.64.1
COPY browser-worker.mjs /app/browser-worker.mjs
RUN chmod -R a+rX /app
USER node
CMD ["node","/app/browser-worker.mjs"]
