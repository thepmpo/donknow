{
  "_metadata": {
    "major_version": 2,
    "minor_version": 1
  },
  "display_information": {
    "name": "덕",
    "description": "일정과 대화에서 필요한 일을 확인하는 개인 비서",
    "background_color": "#2166d8"
  },
  "oauth_config": {
    "redirect_urls": [
      "https://duckduck-test.onrender.com/api/integrations/slack/callback"
    ],
    "scopes": {
      "user": [
        "channels:read",
        "channels:history",
        "groups:read",
        "groups:history",
        "im:read",
        "im:history",
        "mpim:read",
        "mpim:history",
        "search:read"
      ],
      "bot": [
        "chat:write",
        "im:write",
        "im:history",
        "app_mentions:read",
        "files:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://duckduck-test.onrender.com/api/webhooks/slack",
      "user_events": [
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim"
      ],
      "bot_events": [
        "message.im",
        "app_mention"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": true
  },
  "features": {
    "bot_user": {
      "display_name": "덕",
      "always_online": false
    }
  }
}
