{
  "expo": {
    "name": "duckduck",
    "slug": "duckduck-donknow",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sjfieni.duckduck",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "덕과 음성으로 대화하기 위해 마이크를 사용해요. 녹음 파일을 보관하지 않아요."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "duckduck",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "remindersPermission": "선택한 미리 알림을 덕의 Todo로 가져오기 위해 접근 권한이 필요해요."
        }
      ],
      "./plugins/with-duck-shortcuts.cjs",
      [
        "expo-image-picker",
        {
          "photosPermission": "선택한 사진을 덕에게 전달하기 위해 사진을 선택해요.",
          "cameraPermission": false,
          "microphonePermission": "덕과 음성으로 대화하기 위해 마이크를 사용해요. 녹음 파일을 보관하지 않아요."
        }
      ],
      [
        "./plugins/with-duck-widget.cjs",
        {
          "enabled": false
        }
      ]
    ],
    "owner": "thepmpo",
    "extra": {
      "eas": {
        "projectId": "f7827732-1b41-485f-b3b2-6bcc145f3c44"
      }
    }
  }
}
