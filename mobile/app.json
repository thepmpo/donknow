{
  "expo": {
    "name": "docen",
    "slug": "duckduck-donknow",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sjfieni.duckduck",
      "buildNumber": "1",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "docen과 음성으로 대화하기 위해 마이크를 사용해요. 녹음 파일을 보관하지 않아요."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "duckduck",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-secure-store",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "아이폰 캘린더의 일정을 docen에서 확인하고 원본에 변경을 반영하기 위해 접근 권한이 필요해요.",
          "remindersPermission": "선택한 미리 알림을 docen의 Todo로 가져오기 위해 접근 권한이 필요해요."
        }
      ],
      "./plugins/with-duck-shortcuts.cjs",
      [
        "expo-image-picker",
        {
          "photosPermission": "선택한 사진을 docen에게 전달하기 위해 사진을 선택해요.",
          "cameraPermission": false,
          "microphonePermission": "docen과 음성으로 대화하기 위해 마이크를 사용해요. 녹음 파일을 보관하지 않아요."
        }
      ],
      [
        "./plugins/with-duck-widget.cjs",
        {
          "enabled": false
        }
      ],
      "expo-video",
      "expo-asset"
    ],
    "owner": "thepmpo",
    "extra": {
      "eas": {
        "projectId": "f7827732-1b41-485f-b3b2-6bcc145f3c44"
      }
    },
    "splash": {
      "image": "./assets/brand/docen-logo-cutout.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF",
      "dark": {
        "image": "./assets/brand/docen-logo-cutout.png",
        "backgroundColor": "#000000"
      }
    }
  }
}
