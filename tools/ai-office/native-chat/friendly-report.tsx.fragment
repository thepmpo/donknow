
type FriendlyOfficeReportSection = { key: string; title: string; paragraphs: string[]; hiddenParagraphs?: number };
/** Read explicit report labels only. This parser never generates a conclusion or rewrites facts. */
function parseFriendlyOfficeReport(content: string): { sections: FriendlyOfficeReportSection[]; olderFormat: boolean; technicalHidden: boolean } {
  const labels: Record<string, { key: string; title: string }> = {
    "한 줄 결론": { key: "conclusion", title: "한 줄 결론" },
    "한줄 결론": { key: "conclusion", title: "한 줄 결론" },
    "결론": { key: "conclusion", title: "결론" },
    "핵심 결론": { key: "conclusion", title: "핵심 결론" },
    "쉽게 말하면": { key: "conclusion", title: "쉽게 말하면" },
    "지금 할 일": { key: "actions", title: "지금 할 일" },
    "다음 할 일": { key: "actions", title: "다음 할 일" },
    "다음 행동": { key: "actions", title: "다음 행동" },
    "추천 행동": { key: "actions", title: "추천 행동" },
    "우선 할 일": { key: "actions", title: "우선 할 일" },
    "내가 결정할 것": { key: "decisions", title: "내가 결정할 것" },
    "사용자가 결정할 것": { key: "decisions", title: "사용자가 결정할 것" },
    "사용자 결정": { key: "decisions", title: "사용자 결정" },
    "결정이 필요한 것": { key: "decisions", title: "결정이 필요한 것" },
    "선택이 필요한 것": { key: "decisions", title: "선택이 필요한 것" },
    "다음 선택지": { key: "options", title: "다음 선택지" },
    "아직 확인하지 못한 것": { key: "unknown", title: "아직 확인하지 못한 것" },
    "확인하지 못한 것": { key: "unknown", title: "확인하지 못한 것" },
    "미확인": { key: "unknown", title: "보고서에 적힌 미확인 내용" },
    "확인 필요": { key: "unknown", title: "확인이 필요한 내용" },
    "완료되어 제외한 일": { key: "completed", title: "보고서에 적힌 완료 항목" },
    "근거": { key: "technical", title: "근거" },
    "읽은 문서·버전": { key: "technical", title: "읽은 문서·버전" },
    "읽은 문서": { key: "technical", title: "읽은 문서" },
    "기술 근거": { key: "technical", title: "기술 근거" },
    "상세 근거": { key: "technical", title: "상세 근거" },
  };
  const labelNames = Object.keys(labels).sort((a, b) => b.length - a.length);
  const escaped = labelNames.map(label => label.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|");
  // Some old outputs put bold section labels in one paragraph. Split only those known labels.
  const normalized = content.replace(new RegExp("(?=\\*\\*(?:" + escaped + ")[：:]?\\*\\*)", "g"), "\n\n");
  const found = new Map<string, FriendlyOfficeReportSection>();
  let current: { key: string; title: string } | null = null;
  let buffer: string[] = [];
  let technicalHidden = false;
  const opaque = (text: string) => /\b[a-f0-9]{16,}\b|(?:\/workspace\/|\/run\/|(?:^|\s)(?:src|docs|server|mobile)\/[\w./-]+)|\b(?:Revision|sha256|sourceHead|permissionDigest)\b/i.test(text);
  function flush() {
    const text = buffer.join("\n").trim(); buffer = [];
    if (!text || !current) return;
    if (current.key === "technical") { technicalHidden = true; return; }
    // Keep a mixed technical paragraph intact in the original rather than cutting away qualifiers.
    const paragraphs = text.split(/\n\s*\n/).map(value => value.trim()).filter(Boolean);
    for (const paragraph of paragraphs) {
      if (opaque(paragraph)) { technicalHidden = true; const section: FriendlyOfficeReportSection = found.get(current.key) || { key: current.key, title: current.title, paragraphs: [] }; section.hiddenParagraphs = (section.hiddenParagraphs || 0) + 1; found.set(current.key, section); continue; }
      const section = found.get(current.key) || { key: current.key, title: current.title, paragraphs: [] };
      section.paragraphs.push(paragraph); found.set(current.key, section);
    }
  }
  for (const line of normalized.split(/\r?\n/)) {
    const plain = line.replace(/^\s*#{1,6}\s*/, "").replace(/^\s*\d+[.)]\s+/, "").replace(/\*\*/g, "").trim();
    const label = labelNames.find(name => plain === name || plain.startsWith(name + ":") || plain.startsWith(name + "："));
    if (label) {
      flush(); current = labels[label];
      const rest = plain.slice(label.length).replace(/^[：:]\s*/, "").trim();
      if (rest) buffer.push(rest);
    } else if (current) buffer.push(line);
  }
  flush();
  const order = ["conclusion", "actions", "decisions", "options", "unknown", "completed"];
  return { sections: order.flatMap(key => found.has(key) ? [found.get(key)!] : []), olderFormat: !found.has("conclusion") || !found.has("actions"), technicalHidden };
}

/** Escape report text rather than interpreting model-produced HTML in the print window. */
function officeReportHtmlEscape(value: string): string {
  const entities: Record<string, string> = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" };
  return value.replace(/[&<>"']/g, character => entities[character]!);
}

function buildOfficeReportPrintHtml(content: string, taskTitle = "AI 사무실 보고서"): string {
  const report = parseFriendlyOfficeReport(content);
  const escape = officeReportHtmlEscape;
  const title = escape(taskTitle.trim() || "AI 사무실 보고서");
  const summary = report.sections.map(section => `<section class="summary"><h2>${escape(section.title)}</h2>${section.hiddenParagraphs ? '<p class="note">설명과 조건이 함께 있는 항목은 빠뜨리지 않도록 아래 원문 전체에 보존했습니다.</p>' : ""}${section.paragraphs.map(paragraph => `<p class="paragraph">${escape(paragraph)}</p>`).join("")}</section>`).join("");
  return `<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="referrer" content="no-referrer"><title>${title}</title><style>
@page{size:A4;margin:18mm}*{box-sizing:border-box}body{margin:0;background:#fff;color:#17212b;font:12pt/1.65 -apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Malgun Gothic","Noto Sans KR",sans-serif}main{max-width:780px;margin:28px auto;padding:0 24px}h1{font-size:23pt;line-height:1.35;margin:0 0 12px;overflow-wrap:anywhere}h2{font-size:15pt;line-height:1.45;margin:24px 0 8px;break-after:avoid}p{margin:8px 0}.paragraph,pre{white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word}pre{font:inherit;margin:12px 0;border-top:1px solid #cbd5e1;padding-top:16px}.note{color:#475569;font-size:10pt}.controls{background:#f1f5f9;border-bottom:1px solid #cbd5e1;padding:16px 24px}.controls button{border:0;border-radius:8px;padding:12px 18px;background:#2563eb;color:#fff;font:inherit;cursor:pointer}.original{margin-top:32px;padding-top:8px;border-top:2px solid #94a3b8}@media print{.controls{display:none}main{margin:0;padding:0;max-width:none}.note{color:#334155}}
</style></head><body><div class="controls"><button type="button" onclick="window.print()">인쇄 / PDF로 저장</button><p>인쇄 창에서 ‘PDF로 저장’을 선택하세요. Mac은 PDF 메뉴, 휴대폰은 인쇄 미리보기의 공유 메뉴를 이용할 수 있어요.</p><p class="note">이 화면을 여는 것만으로 파일 저장이나 메일 발송이 완료되지는 않습니다.</p></div><main><h1>${title}</h1><p class="note">현재 보고서에 적힌 내용입니다. 요약에서 생략된 근거와 조건도 원문 전체에 포함합니다.</p>${report.olderFormat ? '<p class="note">이전 형식의 보고서라 결론과 할 일이 따로 정리되어 있지 않을 수 있습니다.</p>' : ""}${summary}<section class="original"><h2>근거와 원문 전체</h2><pre>${escape(content)}</pre></section></main></body></html>`;
}

function openOfficeReportPrint(content: string, taskTitle?: string): boolean {
  if (typeof window === "undefined") return false;
  // Open directly inside the user's click; no asynchronous call can trigger a new window.
  const preview = window.open("", "_blank", "width=900,height=900");
  if (!preview) {
    window.alert("인쇄 창을 열지 못했어요. 브라우저에서 이 사무실의 팝업을 허용한 뒤 다시 눌러주세요.");
    return false;
  }
  try {
    preview.opener = null;
    preview.document.open();
    preview.document.write(buildOfficeReportPrintHtml(content, taskTitle));
    preview.document.close();
    preview.focus();
    return true;
  } catch {
    preview.close();
    window.alert("인쇄 화면을 준비하지 못했어요. 보고서는 그대로 보존되어 있습니다. 다시 눌러주세요.");
    return false;
  }
}

export function FriendlyOfficeReport({ content, taskTitle }: { content: string; taskTitle?: string }) {
  const report = parseFriendlyOfficeReport(content);
  return <section aria-label="읽기 쉬운 보고서" className="min-w-0 space-y-4 text-sm leading-7">
    <div className="flex flex-wrap items-center gap-2"><button type="button" className="rounded-lg border border-slate-500 px-3 py-2 text-sm" onClick={()=>openOfficeReportPrint(content, taskTitle)}>PDF로 저장·인쇄</button><span className="text-xs opacity-75">인쇄 화면에서 PDF로 저장을 선택하세요.</span></div>
    <OfficeReportMail taskTitle={taskTitle||"AI 사무실 보고서"}/>
    {taskTitle && <p className="break-words text-base font-semibold">{taskTitle}</p>}
    {report.olderFormat && <p className="rounded-lg border border-amber-500/30 bg-amber-500/10 px-3 py-2 text-sm leading-6" role="note">이전 보고서라 핵심이 따로 정리되어 있지 않아요. 원문은 아래에서 볼 수 있어요.</p>}
    {report.sections.map(section => <section key={section.key} aria-label={section.title} className="min-w-0 rounded-xl border border-slate-500/30 p-3">
      <h4 className="mb-2 text-base font-semibold">{section.title}</h4>
      <div className="space-y-3 break-words">{!!section.hiddenParagraphs && <p className="text-sm leading-6 opacity-80">이 항목은 설명과 조건이 함께 있어요. 빠뜨리지 않도록 아래 원문에서 확인해주세요.</p>}{section.paragraphs.map((paragraph, index) => <div key={index} className="min-w-0 [overflow-wrap:anywhere]"><MessageContent content={paragraph}/></div>)}</div>
    </section>)}
    {!report.sections.length && <p className="text-sm leading-6">아직 결론과 할 일이 따로 정리되어 있지 않아요. 아래에서 보고서 전체를 볼 수 있어요.</p>}
    {report.technicalHidden && <p className="text-xs leading-5 opacity-75">문서 경로와 버전은 아래 근거에 모았어요.</p>}
    <details className="min-w-0 rounded-xl border border-slate-500/30 p-3">
      <summary className="cursor-pointer text-sm font-semibold">근거와 원문 전체 보기</summary>
      <p className="my-2 text-xs leading-5 opacity-75">저장된 원문 그대로입니다. 위 항목에 표시되지 않은 내용도 모두 포함합니다.</p>
      <div className="min-w-0 whitespace-normal break-words [overflow-wrap:anywhere]"><MessageContent content={content}/></div>
    </details>
  </section>;
}

export { buildOfficeReportPrintHtml };
