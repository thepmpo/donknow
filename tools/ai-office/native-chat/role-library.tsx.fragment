
type OfficeRoleGuideStatus = {
  projectId: string;
  connected: boolean;
  version: number;
  roles: {id: string; label: string}[];
};

function OfficeRoleGuidesLibrary() {
  const [projects, setProjects] = useState<{id:string;name:string}[]>([]);
  const [projectId, setProjectId] = useState("");
  const [projectLoading, setProjectLoading] = useState(true);
  const [projectError, setProjectError] = useState("");
  const [projectsRetry, setProjectsRetry] = useState(0);
  const [pack, setPack] = useState<OfficeRoleGuideStatus|null>(null);
  const [loading, setLoading] = useState(false);
  const [statusError, setStatusError] = useState("");
  const [statusRetry, setStatusRetry] = useState(0);
  const [busy, setBusy] = useState(false);
  const [notice, setNotice] = useState("");
  const [resultUnknown, setResultUnknown] = useState(false);
  const selectedProject = useRef(projectId);
  selectedProject.current = projectId;
  const generation = useRef(0);
  const connection = useRef<{generation:number;controller:AbortController}|null>(null);

  const descriptions: Record<string,string> = {
    planning:"사용자 불편을 정리하고 무엇부터 할지 우선순위를 제안해요.",
    development:"원인을 확인하고 필요한 코드와 테스트를 검토해요.",
    design:"화면 흐름, 글자, 버튼 상태와 모바일 사용성을 검토해요.",
    qa:"정상 동작뿐 아니라 오류·지연·중복 실행을 확인해요.",
    devsecops:"권한, 입력, 비밀값과 외부 전송 경계를 확인해요.",
    operations:"실행·업데이트·배포 상태와 복구 순서를 확인해요.",
  };

  function errorText(error: unknown): string {
    const code = error instanceof Error ? error.message : "";
    if (code === "office_open_from_start_file") return "사무실 접속을 다시 확인해야 해요. 컴퓨터에서 0번 시작 파일로 사무실을 다시 열어주세요.";
    if (code === "office_role_guides_receipt_changed") return "저장된 지침 연결 기록이 달라져 확인이 필요해요. 기존 기록은 덮어쓰지 않았습니다.";
    if (code === "office_manual_assignment_required") return "이 프로젝트에는 아직 지침을 연결할 수 없어요. 연결할 다른 프로젝트를 확인해주세요.";
    return "지침 연결 상태를 확인하지 못했어요. 아래 버튼으로 상태를 다시 확인해주세요.";
  }

  async function readJson(url: string, signal: AbortSignal, body?: unknown, csrf?: string) {
    const response = await fetch(url, {method:body === undefined ? "GET" : "POST", credentials:"same-origin", cache:"no-store", signal,
      ...(body === undefined ? {} : {headers:{"content-type":"application/json","x-control-csrf":csrf || ""},body:JSON.stringify(body)})});
    const result = await response.json();
    if (!response.ok) throw new Error(typeof result.error === "string" ? result.error : "office_role_guides_unavailable");
    return result;
  }

  function checkedStatus(value: OfficeRoleGuideStatus, expectedProject: string): OfficeRoleGuideStatus {
    if (!value || value.projectId !== expectedProject || typeof value.connected !== "boolean" ||
        !Number.isSafeInteger(value.version) || !Array.isArray(value.roles) ||
        value.roles.some(role => !role || typeof role.id !== "string" || typeof role.label !== "string")) {
      throw new Error("office_role_guides_invalid_status");
    }
    return value;
  }

  useEffect(() => {
    const controller = new AbortController();
    let live = true;
    const timeout = window.setTimeout(() => controller.abort(), 20000);
    setProjectLoading(true);setProjectError("");
    void readJson("/control-api/projects", controller.signal).then(result => {
      if (!live) return;
      if (!Array.isArray(result.projects) || result.projects.some((p:{id?:unknown;name?:unknown}) => !p || typeof p.id !== "string" || typeof p.name !== "string")) {
        throw new Error("office_role_guides_invalid_projects");
      }
      setProjects(result.projects);
      setProjectId(previous => result.projects.some((p:{id:string}) => p.id === previous) ? previous : result.projects[0]?.id || "");
    }).catch(error => { if (live) setProjectError(errorText(error)); })
      .finally(() => { window.clearTimeout(timeout); if (live) setProjectLoading(false); });
    return () => { live = false;window.clearTimeout(timeout);controller.abort(); };
  }, [projectsRetry]);

  useEffect(() => {
    const current = ++generation.current;
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 20000);
    connection.current?.controller.abort();connection.current = null;
    setPack(null);setStatusError("");setNotice("");setBusy(false);setResultUnknown(false);
    if (!projectId) { setLoading(false);window.clearTimeout(timeout);return () => controller.abort(); }
    setLoading(true);
    void readJson("/control-api/role-guides?projectId=" + encodeURIComponent(projectId), controller.signal)
      .then(result => {
        if (generation.current !== current || selectedProject.current !== projectId || controller.signal.aborted) return;
        setPack(checkedStatus(result, projectId));
      }).catch(error => {
        if (generation.current === current && selectedProject.current === projectId) setStatusError(errorText(error));
      }).finally(() => {
        window.clearTimeout(timeout);
        if (generation.current === current && selectedProject.current === projectId) setLoading(false);
      });
    return () => { ++generation.current;window.clearTimeout(timeout);controller.abort();connection.current?.controller.abort();connection.current = null; };
  }, [projectId, statusRetry]);

  async function connectRecommended() {
    if (!projectId || !pack || pack.connected || loading || busy || resultUnknown || connection.current) return;
    const expectedProject = projectId, current = generation.current, controller = new AbortController();
    connection.current = {generation:current,controller};
    const timeout = window.setTimeout(() => controller.abort(), 20000);
    let submitted = false;
    const stillCurrent = () => generation.current === current && selectedProject.current === expectedProject;
    setBusy(true);setNotice("");
    try {
      const session = await readJson("/control-api/session", controller.signal);
      if (!stillCurrent()) return;
      if (typeof session.csrf !== "string" || !session.csrf) throw new Error("office_refresh_before_action");
      submitted = true;
      const result = checkedStatus(await readJson("/control-api/role-guides/connect", controller.signal,
        {projectId:expectedProject,confirmation:true}, session.csrf), expectedProject);
      if (!stillCurrent()) return;
      setPack(result);
      setNotice(result.connected ? "다음 새 업무부터 공통 지침과 담당 직무의 지침이 함께 전달돼요. 이미 등록한 업무는 그대로 유지합니다." : "연결 완료를 확인하지 못했어요. 상태를 다시 확인해주세요.");
      if (!result.connected) setResultUnknown(true);
    } catch (error) {
      if (!stillCurrent()) return;
      setResultUnknown(submitted);
      setNotice(submitted ? "연결 결과를 확인하지 못했어요. 자동으로 다시 요청하지 않습니다. ‘상태 다시 확인’을 눌러주세요." : errorText(error));
    } finally {
      window.clearTimeout(timeout);
      if (connection.current?.generation === current) connection.current = null;
      if (stillCurrent()) setBusy(false);
    }
  }

  return <section data-office-role-guides className="space-y-4 text-slate-100" aria-label="추천 업무 지침">
    <header className="rounded-xl border border-slate-700 bg-slate-800/70 p-5">
      <h2 className="text-xl font-bold">추천 업무 지침(스킬)</h2>
      <p className="mt-2 text-sm leading-6 text-slate-300">한 번 연결하면 모든 직원에게 공통 지침과 각자 맡은 업무에 필요한 지침을 전달해요.</p>
      <p className="mt-1 text-sm leading-6 text-slate-300">새로 등록하는 업무부터 적용되며, 이미 등록했거나 실행 중인 업무는 바뀌지 않아요.</p>
    </header>
    {projectLoading ? <p role="status">프로젝트를 불러오는 중이에요.</p> : projectError ?
      <div role="alert" className="rounded-lg border border-amber-600 p-4"><p>{projectError}</p><button className="mt-3 min-h-11 rounded border px-4 py-2" onClick={() => setProjectsRetry(value => value + 1)}>프로젝트 다시 불러오기</button></div> :
      projects.length === 0 ? <p className="rounded-lg border border-slate-700 p-4">아직 연결된 프로젝트가 없어요. 사무실의 프로젝트 연결 상태를 먼저 확인해주세요.</p> : <>
        <label className="block text-sm">프로젝트
          <select aria-label="지침을 연결할 프로젝트" value={projectId} className="mt-2 block min-h-11 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-base" onChange={event => {
            ++generation.current;selectedProject.current = event.target.value;connection.current?.controller.abort();connection.current = null;
            setPack(null);setNotice("");setBusy(false);setResultUnknown(false);setProjectId(event.target.value);
          }}>{projects.map(project => <option key={project.id} value={project.id}>{project.name}</option>)}</select>
        </label>
        {loading && <p role="status">이 프로젝트의 연결 상태를 확인하는 중이에요.</p>}
        {statusError && <p role="alert" className="rounded-lg border border-amber-600 p-4">{statusError}</p>}
        {pack && <>
          <div className="rounded-xl border border-slate-700 bg-slate-800/70 p-4">
            <p className="font-semibold">{pack.connected ? "다음 새 업무에 연결됨" : "아직 연결하지 않았어요"}</p>
            <p className="mt-2 text-sm leading-6 text-slate-300">공통 지침: 목표·문서 확인, 기존 데이터 보존, 확인한 사실과 미확인 구분, 쉽게 읽히는 보고서.</p>
            <button disabled={pack.connected || busy || resultUnknown} className="mt-4 min-h-11 w-full rounded-lg bg-blue-600 px-4 py-3 text-sm font-semibold text-white disabled:opacity-50 sm:w-auto" onClick={() => void connectRecommended()}>
              {busy ? "연결 확인 중…" : pack.connected ? "추천 지침 연결됨" : resultUnknown ? "상태 확인 필요" : "추천 스킬 한 번에 연결"}
            </button>
          </div>
          <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{pack.roles.map(role => <article key={role.id} className="rounded-xl border border-slate-700 bg-slate-800/50 p-4">
            <h3 className="font-semibold">{role.label}</h3><p className="mt-2 text-sm leading-6 text-slate-300">{descriptions[role.id] || "공통 지침과 담당 업무에 맞는 검토 기준을 확인해요."}</p>
          </article>)}</div>
        </>}
        {notice && <p role="status" className="rounded-lg border border-slate-600 p-4 text-sm leading-6">{notice}</p>}
        <button disabled={loading || busy} className="min-h-11 rounded-lg border border-slate-600 px-4 py-2 text-sm disabled:opacity-50" onClick={() => setStatusRetry(value => value + 1)}>상태 다시 확인</button>
      </>}
    <footer className="space-y-2 text-sm leading-6 text-slate-400">
      <p>여기서는 검토한 공통·직무 지침을 연결해요. 외부 문서고의 모든 스킬을 내려받거나 모델을 재학습하지는 않아요.</p>
      <p>연결 표시만으로 직원이 지침을 읽었다고 판단하지 않아요. 실제 활용 내용은 업무 보고서에서 확인해주세요. 제품 기획·디자인 자료는 상단 문서함에 넣어주세요.</p>
    </footer>
  </section>;
}
