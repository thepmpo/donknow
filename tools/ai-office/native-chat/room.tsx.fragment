
type OfficeRoomEvent = { id: string; time: number; kind: string; senderType: "ceo" | "agent" | "system"; senderId?: string; receiverId?: string; senderName?: string; taskId?: string; content: string };
type OfficeRoomTask = { id: string; title: string; status: string; result?: string; reportHash?: string; reportEligible?: boolean; project_id: string; started_at?: number; updated_at?: number; runtime?: { checked: boolean; processTracked: boolean | null; lastActivityAt?: number }; activity?: { lastAt?: number }; agent: { id?: string; name: string }; request?: { prompt: string; state: string; startedAt?: string } };
type OfficeRoomDraft = { id: string; taskId?: string; digest?: string; projectId: string; projectName?: string; agentName?: string; prompt: string; kind: "directive" | "question" | "announcement" };
function OfficeNativeChatPanel({ selectedAgent, agents, onClose }: ChatPanelProps) {
  const [input,setInput]=useState("");const [mode,setMode]=useState<ChatMode>("chat");const [whole,setWhole]=useState(!selectedAgent);
  const [projects,setProjects]=useState<{id:string;name:string}[]>([]);const [projectId,setProjectId]=useState("");const [tasks,setTasks]=useState<OfficeRoomTask[]>([]);const [events,setEvents]=useState<OfficeRoomEvent[]>([]);
  const [cursor,setCursor]=useState<string|null>(null);const [loadingOlder,setLoadingOlder]=useState(false);const [agenda,setAgenda]=useState(false);const [notice,setNotice]=useState("");const [checkedAt,setCheckedAt]=useState<number|null>(null);const [busy,setBusy]=useState(false);const [draft,setDraft]=useState<OfficeRoomDraft|null>(null);const [unknown,setUnknown]=useState(false);const [parent,setParent]=useState<string|null>(null);
  const csrf=useRef("");const refreshBusy=useRef(false);const initialized=useRef(false);const request=useRef<{signature:string;id:string}|null>(null);const alive=useRef(true);const autoStick=useRef(true);
  const messagesEndRef=useRef<HTMLDivElement>(null);const textareaRef=useRef<HTMLTextAreaElement>(null);const spriteMap=useMemo(()=>buildSpriteMap(agents),[agents]);const {locale}=useI18n();
  const contact=whole?null:selectedAgent;const getName=(agent:Agent|null|undefined)=>agent?.name_ko||agent?.name||"직원";
  const tr=(ko:string)=>ko==="전사 공지"?"공지":ko.includes("모든 에이전트에게 전달")?"공지는 방에 저장하며 직원 읽음은 확인되지 않습니다.":ko;
  const headerTr=(ko:string)=>ko==="전사 공지"?"전체 대화":ko==="모든 에이전트에게 전달됩니다"?"직원별 실제 메시지를 한곳에서 봅니다.":tr(ko);
  const api=useCallback(async(url:string,body?:unknown)=>{const response=await fetch(url,{method:body===undefined?"GET":"POST",credentials:"same-origin",cache:"no-store",headers:body===undefined?{}:{"content-type":"application/json","x-control-csrf":csrf.current},...(body===undefined?{}:{body:JSON.stringify(body)}),signal:AbortSignal.timeout(25000)});const result=await response.json();if(!response.ok)throw Object.assign(new Error(String(result.error||"office_request_failed")),{status:response.status});return result;},[]);
  const refresh=useCallback(async(before?:string|null)=>{if(refreshBusy.current)return;refreshBusy.current=true;try{const session=await api("/control-api/session");csrf.current=session.csrf;const [ps,ts,room]=await Promise.all([api("/control-api/projects"),api("/control-api/tasks"),api("/control-api/room"+(before?"?before="+encodeURIComponent(before):""))]);if(!alive.current)return;setProjects(ps.projects);setProjectId(old=>ps.projects.some((p:{id:string})=>p.id===old)?old:ps.projects[0]?.id||"");setTasks(ts.tasks);setEvents(old=>{const merged=new Map(old.map(e=>[e.id,e]));for(const e of room.events as OfficeRoomEvent[])merged.set(e.id,e);return [...merged.values()].sort((a,b)=>a.time-b.time||(a.id<b.id?-1:1));});if(before||!initialized.current)setCursor(room.before||null);initialized.current=true;setCheckedAt(Date.now());}catch{if(alive.current)setNotice("연결을 확인하지 못했습니다. 마지막으로 불러온 기록만 보입니다. 0번 시작 파일로 열었는지 확인해주세요.");}finally{refreshBusy.current=false;}},[api]);
  useEffect(()=>{alive.current=true;void refresh();const timer=setInterval(()=>{if(document.visibilityState==="visible")void refresh();},4000);return()=>{alive.current=false;clearInterval(timer);};},[refresh]);
  useEffect(()=>{if(autoStick.current&&!loadingOlder)messagesEndRef.current?.scrollIntoView({block:"end"});},[events.length,loadingOlder]);
  useEffect(()=>{if(unknown&&draft?.taskId&&tasks.some(t=>t.id===draft.taskId&&["in_progress","review","done"].includes(t.status))){setUnknown(false);setDraft(null);setInput("");setNotice("실행 상태가 확인됐습니다. 안건에서 진행을 확인하세요.");}},[unknown,draft,tasks]);
  function progress(t:OfficeRoomTask){if(t.status==="review")return t.reportEligible?"보고서 도착 · 확인 대기":"결과 기록 있음 · 완료 조건 미확인";if(t.status==="done")return "확인 완료";if(t.status!=="in_progress"&&t.request?.state==="inspection_required")return "실행 요청 결과 확인 필요 · 자동 재실행하지 않음";if(t.status!=="in_progress")return t.request?.state==="draft"?"안건 등록됨 · 아직 실행하지 않음":t.status==="pending"?"추가 확인 필요":"실행 대기";const connection=t.runtime?.checked?(t.runtime.processTracked?"실행기 연결 확인":"실행기 연결 없음 · 확인 필요"):"실행기 연결 미확인";const start=t.started_at||(t.request?.startedAt?Date.parse(t.request.startedAt):0),last=Math.max(t.updated_at||0,t.activity?.lastAt||0,t.runtime?.lastActivityAt||0,start);return connection+(start?" · "+Math.max(0,Math.floor((Date.now()-start)/1000))+"초 경과":"")+(last?" · 최근 기록 "+new Date(last).toLocaleTimeString("ko-KR"):"")+(last&&Date.now()-last>120000?" · 2분간 새 기록 없음(멈춤 미확인)":"");}
  const visibleTasks=tasks.filter(t=>whole||!contact||t.agent.id===contact.id);
  const visibleMessages:Message[]=events.filter(e=>whole||!contact||e.senderId===contact.id||e.receiverId===contact.id||e.kind==="announcement"||tasks.some(t=>t.id===e.taskId&&t.agent.id===contact.id)).map(e=>{const task=tasks.find(t=>t.id===e.taskId);return {id:e.id,sender_type:e.senderType,sender_id:e.senderId||null,sender_name:e.senderName||null,receiver_type:"all",receiver_id:e.receiverId||null,message_type:e.kind==="announcement"?"announcement":e.kind==="report"?"report":"chat",task_id:e.taskId||null,created_at:e.time,content:(e.kind==="directive"?"[안건 · 업무 지시]\n":e.kind==="question"?"[안건 · 질문]\n":e.kind==="announcement"?"[공지 · 읽음 미확인]\n":"")+e.content+(task?"\n\n상태: "+progress(task):"")};});
  async function send(){if(busy||!input.trim()||!projectId)return;if(mode==="chat"){if(input.trim().length>12000){setNotice("대화는12,000자까지 저장할 수 있습니다.");return;}const signature=JSON.stringify(["chat",input.trim(),projectId,contact?.id]);if(request.current?.signature!==signature)request.current={signature,id:crypto.randomUUID()};setBusy(true);try{await api("/control-api/chat-messages",{id:request.current.id,projectId,prompt:input.trim(),receiverId:contact?.id});setInput("");request.current=null;setNotice("대화를 저장했습니다. 상대의 읽음·응답 여부는 미확인입니다.");await refresh();}catch{setNotice("대화를 저장하지 못했습니다. 입력 내용은 유지했습니다.");}finally{setBusy(false);}return;}const kind=mode==="announcement"?"announcement":mode==="task"?"directive":"question";if(contact&&contact.cli_provider!=="codex"&&kind!=="announcement"){setNotice("이 직원의 실행기는 아직 연결되지 않았습니다. 전체 대화로 전환하면 현재 검토 담당자에게 요청할 수 있습니다.");return;}if(input.trim().length>(kind==="announcement"?4000:12000)){setNotice("메시지가 너무 깁니다. 공지는4,000자, 요청은12,000자까지 보낼 수 있어요.");return;}const signature=JSON.stringify([input.trim(),kind,projectId,parent,contact?.id]);if(request.current?.signature!==signature)request.current={signature,id:crypto.randomUUID()};setBusy(true);setNotice("");try{const d=kind==="announcement"?{id:request.current.id,projectId,prompt:input.trim(),kind}:await api("/control-api/requests",{id:request.current.id,projectId,prompt:input.trim(),kind,parentTaskId:parent,agentId:contact?.id});setDraft({...d,projectId,prompt:input.trim(),kind});setUnknown(false);await refresh();}catch(e){setNotice(String((e as Error).message).includes("agent_not_configured")?"이 프로젝트에 해당 직원의 실행 연결이 없습니다. 전체 대화에서 검토 담당자에게 요청해주세요.":"안건을 등록하지 못했습니다. 로그인·프로젝트와 연결 상태를 확인해주세요.");}finally{setBusy(false);}}
  async function execute(){if(!draft||busy||unknown)return;setBusy(true);try{if(draft.kind==="announcement")await api("/control-api/notices",{id:draft.id,projectId:draft.projectId,prompt:draft.prompt,confirmation:true});else{const result=await api("/control-api/requests/"+draft.id+"/start",{digest:draft.digest,confirmation:true});if(!result.started)throw Error("execution_unconfirmed");}setNotice(draft.kind==="announcement"?"공지를 저장했습니다. 직원 읽음은 미확인입니다.":"실행을 요청했습니다. 안건에서 실제 연결과 결과를 확인하세요.");setDraft(null);setInput("");setParent(null);request.current=null;await refresh();}catch(e){const status=(e as {status?:number}).status;if(draft.kind!=="announcement"&&(!status||status>=500)){setUnknown(true);setNotice("실행 결과가 아직 미확인입니다. 중복 실행하지 말고 안건 상태를 확인해주세요.");}else setNotice("처리하지 못했습니다. 진행 중 업무·로그인·권한 또는 변경된 요청을 확인해주세요.");}finally{setBusy(false);}}
  async function accept(t:OfficeRoomTask){if(!t.reportHash||busy||!window.confirm("이 보고서를 읽고 확인 완료로 기록할까요? 새 AI 업무·개발·배포는 시작하지 않습니다."))return;setBusy(true);try{await api("/control-api/tasks/"+encodeURIComponent(t.id)+"/accept",{reportHash:t.reportHash,confirmation:true});setNotice("보고서 확인을 기록했습니다.");await refresh();}catch{setNotice("보고서가 변경됐거나 완료 조건을 확인하지 못했습니다. 새로 불러와 다시 읽어주세요.");}finally{setBusy(false);}}
  return <div data-office-native-room className="fixed inset-0 z-50 flex h-full w-full flex-col bg-gray-900 shadow-2xl lg:relative lg:inset-auto lg:z-auto lg:w-[min(520px,48vw)] lg:border-l lg:border-gray-700" onScrollCapture={e=>{const el=e.target as HTMLElement;if(el.scrollHeight>el.clientHeight+30&&el.tagName!=="TEXTAREA")autoStick.current=el.scrollHeight-el.clientHeight-el.scrollTop<80;}}>
    <ChatPanelHeader selectedAgent={contact} selectedDeptName={contact?"직원 대화":"전체 대화"} spriteMap={spriteMap} tr={headerTr} getAgentName={getName} getRoleLabel={role=>ROLE_LABELS[role as keyof typeof ROLE_LABELS]?.ko||role} getStatusLabel={a=>a==="working"?"작업 중":"기록 보기"} statusColors={STATUS_COLORS} showAnnouncementBanner={false} visibleMessagesLength={visibleMessages.length} onClose={onClose}/>
    <div className="flex shrink-0 flex-wrap items-center gap-2 border-b border-gray-700 p-2 text-sm"><button className="rounded border px-3 py-2" onClick={()=>{setWhole(true);setParent(null);}}>전체 대화</button>{selectedAgent&&<button className="rounded border px-3 py-2" onClick={()=>setWhole(false)}>{getName(selectedAgent)} 대화</button>}<button className="rounded border px-3 py-2" onClick={()=>setAgenda(v=>!v)}>안건 {visibleTasks.length}</button><label className="sr-only" htmlFor="native-room-project">프로젝트</label><select id="native-room-project" aria-label="프로젝트" className="min-w-0 rounded bg-gray-800 px-2 py-2" value={projectId} onChange={e=>{setProjectId(e.target.value);setParent(null);}}>{projects.map(p=><option key={p.id} value={p.id}>{p.name}</option>)}</select><span className="text-xs text-gray-400">{checkedAt?"상태 확인 "+new Date(checkedAt).toLocaleTimeString("ko-KR"):"연결 확인 중"}</span></div>
    {agenda&&<section aria-label="안건 목록" className="max-h-72 shrink-0 overflow-y-auto border-b border-gray-700 p-3 text-sm">{!visibleTasks.length&&<p>등록된 안건이 없습니다.</p>}{visibleTasks.map(t=><details key={t.id} className="mb-2 rounded border border-gray-700 p-2"><summary>{t.title} · {progress(t)}</summary><p className="my-2 text-xs">담당: {t.agent.name}</p><p className="whitespace-pre-wrap">{t.request?.prompt}</p>{t.result?<div className="my-2 max-h-72 overflow-y-auto"><MessageContent content={t.result}/></div>:<p>아직 저장된 보고서가 없습니다.</p>}{t.status==="review"&&t.result&&t.reportEligible&&<button disabled={busy} className="rounded border px-3 py-2" onClick={()=>void accept(t)}>보고서 확인 완료</button>}{["review","done"].includes(t.status)&&t.result&&<button className="ml-2 rounded border px-3 py-2" onClick={()=>{setParent(t.id);setProjectId(t.project_id);setMode("question");setAgenda(false);textareaRef.current?.focus();}}>이 안건에 추가 요청</button>}</details>)}</section>}
    {cursor&&<button className="shrink-0 py-2 text-sm" disabled={loadingOlder} onClick={async()=>{setLoadingOlder(true);try{await refresh(cursor);}finally{setLoadingOlder(false);}}}>이전 대화 더 보기</button>}
    <ChatMessageList selectedAgent={contact} visibleMessages={visibleMessages} agents={agents} spriteMap={spriteMap} locale={locale} tr={tr} getAgentName={getName} decisionRequestByMessage={new Map()} decisionReplyKey={null} onDecisionOptionReply={()=>{}} onDecisionManualDraft={()=>{}} streamingMessage={null} messagesEndRef={messagesEndRef}/>
    {notice&&<p role="status" className="shrink-0 whitespace-pre-wrap px-3 py-2 text-sm text-amber-300">{notice}</p>}{parent&&<button className="shrink-0 px-3 text-left text-xs" onClick={()=>setParent(null)}>이전 안건에 추가 요청 중 · 눌러 해제</button>}
    <p className="shrink-0 px-3 text-xs text-gray-400">대화는 저장하고 지시·질문은 안건 등록 후 실행을 확인합니다. 공지는 저장만 하며 읽음은 미확인입니다.</p>
    <ChatComposer allowGlobalTasks mode={mode} input={input} selectedAgent={contact} isDirectiveMode={false} isAnnouncementMode={mode==="announcement"} tr={tr} getAgentName={getName} textareaRef={textareaRef} onModeChange={setMode} onInputChange={setInput} onSend={()=>void send()} onKeyDown={e=>{if(e.key==="Enter"&&!e.shiftKey&&!e.nativeEvent.isComposing){e.preventDefault();void send();}}}/>
    {draft&&<div role="dialog" aria-label="안건 실행 확인" aria-modal="true" className="absolute inset-0 z-10 flex items-center justify-center bg-black/70 p-3"><div className="max-h-full w-full overflow-y-auto rounded-xl border border-gray-600 bg-gray-900 p-4"><h2 className="text-lg font-bold">{draft.kind==="announcement"?"공지 저장 확인":"안건 등록됨 · 실행 내용 확인"}</h2><p className="my-2 text-sm">{draft.kind==="announcement"?"AI 실행 없이 저장합니다.":"담당: "+(draft.agentName||"검토 담당자")+" · 읽기 전용 검토"}</p><pre className="my-3 whitespace-pre-wrap break-words font-sans text-sm">{draft.prompt}</pre>{notice&&<p role="status" className="my-2 text-sm text-amber-300">{notice}</p>}<button disabled={busy} className="mr-2 rounded border px-3 py-2" onClick={()=>setDraft(null)}>닫기</button><button disabled={busy||unknown} className="rounded bg-blue-600 px-3 py-2 text-white" onClick={()=>void execute()}>{busy?"처리 중…":draft.kind==="announcement"?"확인하고 공지 저장":"확인하고 실행"}</button></div></div>}
  </div>;
}
