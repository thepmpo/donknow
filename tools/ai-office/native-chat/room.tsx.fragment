
type OfficeRoomEvent = { id: string; time: number; kind: string; source?:string; senderType: "ceo" | "agent" | "system"; senderId?: string; receiverId?: string; senderName?: string; taskId?: string; content: string };
type OfficeRoomTask = { id: string; title: string; status: string; result?: string; reportHash?: string; reportEligible?: boolean; project_id: string; started_at?: number; updated_at?: number; runtime?: { checked: boolean; processTracked: boolean | null; lastActivityAt?: number }; activity?: { lastAt?: number }; agent: { id?: string; name: string }; request?: { prompt: string; state: string; startedAt?: string } };
type OfficeMeeting = {createdAt?:number;updatedAt?:number;id:string;projectId:string;title:string;prompt:string;digest:string;state:string;participants:{agentId:string;name:string;department:string}[];maxCalls:number;completedCalls:number;currentTaskId?:string;finalTaskId?:string;resumeRequired?:boolean;errorCode?:string;children?:{agentId:string;name:string;taskId:string;state:string;kind?:string}[]};
type OfficeTeam = {total:number;configuredCount:number;readyCount:number;provider:{ready:boolean};roster:{id:string;name:string;role:string;department:string;blockedReason?:string|null;configured:boolean;ready:boolean;lastExecution?:{status:string;verified?:boolean}|null}[];meetings:OfficeMeeting[]};
type OfficeRoomDraft = { id: string; taskId?: string; digest?: string; projectId: string; projectName?: string; agentName?: string; prompt: string; kind: "directive" | "question" | "announcement" | "meeting" | "development"; participants?:OfficeMeeting["participants"];maxCalls?:number };
type OfficeDevelopment = {id:string;taskId:string;projectId:string;agentId:string;title:string;prompt:string;digest:string;state:string;expiresAt:number;createdAt?:number|string;updatedAt?:number|string;taskStatus?:string;result?:string;candidateAvailable?:boolean};
type OfficeRelease = {id:string;requestId:string;state:string;digest?:string;deployDigest?:string;commit?:string;githubUrl?:string;url?:string;summary?:string;humanSummary?:string;diff?:string;diffTruncated?:boolean;files?:(string|{path:string;status?:string})[];deployment?:{requested:boolean;status:string;url?:string;commit?:string;liveConfirmed?:boolean};tests?:{name:string;passed:boolean;exitCode?:number}[];blockers?:string[];expiresAt?:number;liveConfirmed?:boolean};
// A rejected start is not an automatic queue entry. Keep the draft for explicit retry.
function officeRequestError(code: string): string {
  const messages: Record<string, string> = {
    office_wait_for_running_task: "다른 업무가 진행 중이라 시작하지 못했어요. 팀장회의 중이라면 회의가 끝난 뒤 이 창의 ‘확인하고 실행’을 다시 눌러주세요. 요청은 등록되어 있으며, 자동으로 시작되지는 않아요.",
    office_policy_must_be_locked: "사무실의 실행 설정을 확인해야 해요. 진행 중 업무가 끝난 뒤 상태를 다시 확인해주세요. 이 요청은 자동으로 시작되지 않아요.",
    office_provider_not_ready: "AI 실행 준비가 끝나지 않았어요. 사무실의 6번 확인 파일로 로그인·실행기·격리 상태를 확인해주세요. 이 메시지만으로 로그인 문제라고 단정할 수는 없어요.",
    office_open_from_start_file: "사무실 접속을 다시 확인해야 해요. 컴퓨터에서 0번 시작 파일로 사무실을 다시 열어주세요. 기존 요청과 로그인은 삭제하지 마세요.",
    office_refresh_before_action: "화면의 연결 정보가 오래됐어요. 새로고침한 뒤 안건 상태를 확인해주세요. 이미 시작된 업무를 다시 요청하지 마세요.",
    office_request_changed_prepare_again: "요청을 등록한 뒤 코드·문서 또는 안건 내용이 달라졌어요. 이 안건은 시작하지 않았습니다. 최신 내용으로 요청을 다시 준비해야 해요.",
    office_followup_context_changed: "연결한 이전 보고서의 내용이나 상태가 달라졌어요. 이 안건은 시작하지 않았습니다. 해당 보고서를 다시 확인하고 추가 요청을 준비해주세요.",
    office_request_inspection_required: "이전에 실행을 시도한 요청이라 결과 확인이 필요해요. 안건에서 실행 상태와 보고서를 먼저 확인해주세요. 자동으로 재실행하지 않습니다.",
    office_task_not_waiting: "이 안건의 상태가 달라져 시작하지 못했어요. 안건에서 진행 상황과 보고서를 확인해주세요.",
  };
  return messages[code] || ("요청을 처리하지 못했어요. 안건 상태를 확인해주세요. " + (/^office_[a-z0-9_]{1,100}$/.test(code) ? "확인 코드: " + code : "확인 코드: office_request_failed"));
}
function OfficeNativeChatPanel({ selectedAgent, agents, onClose }: ChatPanelProps) {
  const [sourcePreview,setSourcePreview]=useState<{projectId:string;sourceHead:string;remoteHead:string;upToDate:boolean;digest:string}|null>(null);const [development,setDevelopment]=useState<OfficeDevelopment[]>([]);const [codeOpen,setCodeOpen]=useState(false);const [codeResult,setCodeResult]=useState<OfficeDevelopment|null>(null);const [release,setRelease]=useState<OfficeRelease|null>(null);const [codeBusy,setCodeBusy]=useState(false);const [codeUnknown,setCodeUnknown]=useState(false);const [diffRead,setDiffRead]=useState(false);
  const [targetId,setTargetId]=useState(selectedAgent?.id||"");const [team,setTeam]=useState<OfficeTeam|null>(null);const [teamBusy,setTeamBusy]=useState(false);const [input,setInput]=useState("");const [mode,setMode]=useState<ChatMode>("chat");const [whole,setWhole]=useState(!selectedAgent);
  const [projects,setProjects]=useState<{id:string;name:string}[]>([]);const [projectId,setProjectId]=useState("");const [tasks,setTasks]=useState<OfficeRoomTask[]>([]);const [events,setEvents]=useState<OfficeRoomEvent[]>([]);
  const [cursor,setCursor]=useState<string|null>(null);const [loadingOlder,setLoadingOlder]=useState(false);const [agenda,setAgenda]=useState(false);const [notice,setNotice]=useState("");const [checkedAt,setCheckedAt]=useState<number|null>(null);const [busy,setBusy]=useState(false);const [draft,setDraft]=useState<OfficeRoomDraft|null>(null);const [unknown,setUnknown]=useState(false);const [parent,setParent]=useState<string|null>(null);
  const projectIdRef=useRef(projectId);projectIdRef.current=projectId;const csrf=useRef("");const refreshBusy=useRef(false);const initialized=useRef(false);const request=useRef<{signature:string;id:string}|null>(null);const alive=useRef(true);const autoStick=useRef(true);
  const messagesEndRef=useRef<HTMLDivElement>(null);const textareaRef=useRef<HTMLTextAreaElement>(null);const spriteMap=useMemo(()=>buildSpriteMap(agents),[agents]);const {locale}=useI18n();
  const contact=whole?null:selectedAgent;const recipient=agents.find(a=>a.id===targetId)||null;const departmentName=(id:string|null|undefined)=>({dev:'개발팀',planning:'기획팀',development:'개발팀',design:'디자인팀',qa:'품질팀',devsecops:'보안팀',operations:'운영팀'} as Record<string,string>)[id||'']||'담당팀';const getName=(agent:Agent|null|undefined)=>agent?.name_ko||agent?.name||"직원";
  const tr=(ko:string)=>ko==="전사 공지"?"공지":ko.includes("모든 에이전트에게 전달")?"공지는 방에 저장하며 직원 읽음은 확인되지 않습니다.":ko;
  const headerTr=(ko:string)=>ko==="전사 공지"?"전체 대화":ko==="모든 에이전트에게 전달됩니다"?"직원별 실제 메시지를 한곳에서 봅니다.":tr(ko);
  const api=useCallback(async(url:string,body?:unknown,timeoutMs=25000)=>{const response=await fetch(url,{method:body===undefined?"GET":"POST",credentials:"same-origin",cache:"no-store",headers:body===undefined?{}:{"content-type":"application/json","x-control-csrf":csrf.current},...(body===undefined?{}:{body:JSON.stringify(body)}),signal:AbortSignal.timeout(timeoutMs)});const result=await response.json();if(!response.ok)throw Object.assign(new Error(String(result.error||"office_request_failed")),{status:response.status});return result;},[]);
  const refresh=useCallback(async(before?:string|null)=>{if(refreshBusy.current)return;refreshBusy.current=true;try{const session=await api("/control-api/session");csrf.current=session.csrf;const [ps,ts,room]=await Promise.all([api("/control-api/projects"),api("/control-api/tasks"),api("/control-api/room"+(before?"?before="+encodeURIComponent(before):""))]);if(!alive.current)return;setProjects(ps.projects);setProjectId(old=>ps.projects.some((p:{id:string})=>p.id===old)?old:ps.projects[0]?.id||"");setTasks(ts.tasks);setEvents(old=>{const merged=new Map(old.map(e=>[e.id,e]));for(const e of room.events as OfficeRoomEvent[])merged.set(e.id,e);return [...merged.values()].sort((a,b)=>a.time-b.time||(a.id<b.id?-1:1));});if(before||!initialized.current)setCursor(room.before||null);initialized.current=true;setCheckedAt(Date.now());try{const code=await api('/control-api/development');if(alive.current&&Array.isArray(code.requests))setDevelopment(code.requests);}catch{/* Old gateway remains usable for product review until updated. */}const selectedProject=ps.projects.find((p:{id:string})=>p.id===projectIdRef.current)?.id||ps.projects[0]?.id;try{const status=await api('/control-api/team'+(selectedProject?'?projectId='+encodeURIComponent(selectedProject):''));if(alive.current)setTeam(status&&Array.isArray(status.roster)&&Array.isArray(status.meetings)?status:null);}catch{if(alive.current)setTeam(null);}}catch{if(alive.current)setNotice("연결을 확인하지 못했습니다. 마지막으로 불러온 기록만 보입니다. 0번 시작 파일로 열었는지 확인해주세요.");}finally{refreshBusy.current=false;}},[api]);
  useEffect(()=>{alive.current=true;void refresh();const timer=setInterval(()=>{if(document.visibilityState==="visible")void refresh();},4000);return()=>{alive.current=false;clearInterval(timer);};},[refresh]);
  useEffect(()=>{if(autoStick.current&&!loadingOlder)messagesEndRef.current?.scrollIntoView({block:"end"});},[events.length,loadingOlder]);
  useEffect(()=>{if(unknown&&draft?.kind==="meeting"&&team?.meetings.some(m=>m.id===draft.id&&m.state!=="prepared")){setUnknown(false);setDraft(null);setAgenda(true);setNotice("회의 상태를 확인했습니다. 아래 회의 진행을 살펴봐주세요.");}if(unknown&&draft?.taskId&&tasks.some(t=>t.id===draft.taskId&&["in_progress","review","done"].includes(t.status))){setUnknown(false);setDraft(null);setInput("");setNotice("실행 상태가 확인됐습니다. 안건에서 진행을 확인하세요.");}},[unknown,draft,tasks,team]);
  function progress(t:OfficeRoomTask){if(t.status!=='in_progress'&&team?.meetings.some(m=>m.state==='stopped'&&m.children?.some(c=>c.taskId===t.id&&c.state==='prepared')))return '회의 중지로 실행하지 않음';if(t.status==="review")return t.reportEligible?"보고서 도착 · 확인 대기":"결과 기록 있음 · 완료 조건 미확인";if(t.status==="done")return "확인 완료";if(t.status!=="in_progress"&&t.request?.state==="inspection_required")return "실행 요청 결과 확인 필요 · 자동 재실행하지 않음";if(t.status!=="in_progress")return t.request?.state==="draft"?"안건 등록됨 · 아직 실행하지 않음":t.status==="pending"?"추가 확인 필요":"실행 대기";const connection=t.runtime?.checked?(t.runtime.processTracked?"실행기 연결 확인":"실행기 연결 없음 · 확인 필요"):"실행기 연결 미확인";const start=t.started_at||(t.request?.startedAt?Date.parse(t.request.startedAt):0),last=Math.max(t.updated_at||0,t.activity?.lastAt||0,t.runtime?.lastActivityAt||0,start);return connection+(start?" · "+Math.max(0,Math.floor((Date.now()-start)/1000))+"초 경과":"")+(last?" · 최근 기록 "+new Date(last).toLocaleTimeString("ko-KR"):"")+(last&&Date.now()-last>120000?" · 2분간 새 기록 없음(멈춤 미확인)":"");}
  const visibleTasks=tasks.filter(t=>whole||!contact||t.agent.id===contact.id);
  const codeEvents:OfficeRoomEvent[]=development.filter(d=>d.createdAt).map(d=>({id:'development:'+d.id,time:typeof d.createdAt==='number'?d.createdAt:Date.parse(d.createdAt!),kind:'development',senderType:'ceo',receiverId:d.agentId,taskId:d.taskId,content:'[코드 수정 요청]\n'+d.prompt}));
  const roomEvents:OfficeRoomEvent[]=[...codeEvents,...events.filter(e=>e.source!=='meeting_request'),...(team?.meetings||[]).filter(m=>m.createdAt).map(m=>({id:'meeting:'+m.id,time:m.createdAt!,kind:'meeting',senderType:'ceo' as const,content:'[팀장회의 안건]\n'+m.prompt}))].sort((a,b)=>a.time-b.time||(a.id<b.id?-1:1));
  const visibleMessages:Message[]=roomEvents.filter(e=>whole||!contact||e.senderId===contact.id||e.receiverId===contact.id||e.kind==="announcement"||tasks.some(t=>t.id===e.taskId&&t.agent.id===contact.id)).map(e=>{const task=tasks.find(t=>t.id===e.taskId);return {id:e.id,sender_type:e.senderType,sender_id:e.senderId||null,sender_name:e.senderName||null,receiver_type:"all",receiver_id:e.receiverId||null,message_type:e.kind==="announcement"?"announcement":e.kind==="report"?"report":"chat",task_id:e.taskId||null,created_at:e.time,content:(e.kind==="directive"?"[안건 · 업무 지시]\n":e.kind==="question"?"[안건 · 질문]\n":e.kind==="announcement"?"[공지 · 읽음 미확인]\n":"")+(e.senderType==="ceo"&&e.receiverId?"@"+(agents.find(a=>a.id===e.receiverId)?.name_ko||agents.find(a=>a.id===e.receiverId)?.name||"선택한 직원")+"\n":"")+e.content+(task&&e.kind!=="report"?"\n\n상태: "+progress(task):"")};});
  async function send(){if(busy||codeBusy||!input.trim()||!projectId)return;if(mode==="development"){if(targetId==="@meeting"){setNotice("코드 수정은 개발 담당 직원에게 맡겨주세요. 받는 사람을 전체 대화 또는 개발 담당자로 바꿔주세요.");return;}if(input.trim().length>12000){setNotice("코드 수정 요청은12,000자까지 보낼 수 있어요.");return;}const signature=JSON.stringify(["development",input.trim(),projectId,recipient?.id]);if(request.current?.signature!==signature)request.current={signature,id:crypto.randomUUID()};setBusy(true);setNotice("");try{const d=await api('/control-api/development/prepare',{id:request.current.id,projectId,prompt:input.trim(),agentId:recipient?.id});setDraft({...d,projectId,prompt:input.trim(),kind:'development',agentName:getName(agents.find(a=>a.id===d.agentId))});setUnknown(false);setCodeOpen(true);await refresh();}catch(e){setNotice(codeError((e as Error).message));}finally{setBusy(false);}return;}if(targetId==="@meeting"){if(!["task","question"].includes(mode)){setNotice("팀장회의는 업무 지시나 질문을 선택해서 시작해주세요.");return;}const signature=JSON.stringify(["meeting",input.trim(),projectId]);if(request.current?.signature!==signature)request.current={signature,id:crypto.randomUUID()};setBusy(true);try{const m=await api("/control-api/team/meetings/prepare",{id:request.current.id,projectId,prompt:input.trim()});setDraft({...m,projectId,kind:"meeting"});setUnknown(false);await refresh();}catch{setNotice("회의를 준비하지 못했습니다. 전체 직원 연결과 팀장 배정, 진행 중 업무를 확인해주세요.");}finally{setBusy(false);}return;}if(mode==="chat"){if(input.trim().length>12000){setNotice("대화는12,000자까지 저장할 수 있습니다.");return;}const signature=JSON.stringify(["chat",input.trim(),projectId,recipient?.id]);if(request.current?.signature!==signature)request.current={signature,id:crypto.randomUUID()};setBusy(true);try{await api("/control-api/chat-messages",{id:request.current.id,projectId,prompt:input.trim(),receiverId:recipient?.id});setInput("");request.current=null;setNotice("대화를 저장했습니다. 상대의 읽음·응답 여부는 미확인입니다.");await refresh();}catch{setNotice("대화를 저장하지 못했습니다. 입력 내용은 유지했습니다.");}finally{setBusy(false);}return;}const kind=mode==="announcement"?"announcement":mode==="task"?"directive":"question";if(recipient&&!team?.roster.some(r=>r.id===recipient.id&&r.configured)&&kind!=="announcement"){setNotice("이 직원의 실행기는 아직 연결되지 않았습니다. 전체 대화로 전환하면 현재 검토 담당자에게 요청할 수 있습니다.");return;}if(input.trim().length>(kind==="announcement"?4000:12000)){setNotice("메시지가 너무 깁니다. 공지는4,000자, 요청은12,000자까지 보낼 수 있어요.");return;}const signature=JSON.stringify([input.trim(),kind,projectId,parent,recipient?.id]);if(request.current?.signature!==signature)request.current={signature,id:crypto.randomUUID()};setBusy(true);setNotice("");try{const d=kind==="announcement"?{id:request.current.id,projectId,prompt:input.trim(),kind}:await api("/control-api/requests",{id:request.current.id,projectId,prompt:input.trim(),kind,parentTaskId:parent,agentId:recipient?.id});setDraft({...d,projectId,prompt:input.trim(),kind});setUnknown(false);await refresh();}catch(e){setNotice(String((e as Error).message).includes("agent_not_configured")?"이 프로젝트에 해당 직원의 실행 연결이 없습니다. 전체 대화에서 검토 담당자에게 요청해주세요.":"안건을 등록하지 못했습니다. 로그인·프로젝트와 연결 상태를 확인해주세요.");}finally{setBusy(false);}}
  async function execute(){if(!draft||busy||unknown)return;setBusy(true);try{if(draft.kind==="development"){const r=await api('/control-api/development/'+encodeURIComponent(draft.id)+'/start',{digest:draft.digest,confirmation:true});if(!r.started)throw Error('execution_unconfirmed');setCodeOpen(true);}else if(draft.kind==="meeting"){const m=await api("/control-api/team/meetings/start",{id:draft.id,digest:draft.digest,confirmation:true});if(!["running","completed"].includes(m.state)){setNotice("회의가 바로 시작되지 않았습니다. 회의 진행 상태에서 대기·확인 사유를 살펴봐주세요.");setDraft(null);await refresh();return;}}else if(draft.kind==="announcement")await api("/control-api/notices",{id:draft.id,projectId:draft.projectId,prompt:draft.prompt,confirmation:true});else{const result=await api("/control-api/requests/"+draft.id+"/start",{digest:draft.digest,confirmation:true});if(!result.started)throw Error("execution_unconfirmed");}setNotice(draft.kind==="development"?"코드 수정을 시작했습니다. 아래 코드 수정·배포에서 결과를 확인하세요. 원본 반영과 배포는 따로 확인합니다.":draft.kind==="meeting"?"팀장회의를 시작했습니다. 실제 의견이 도착하는 대로 대화와 안건에서 볼 수 있어요.":draft.kind==="announcement"?"공지를 저장했습니다. 직원 읽음은 미확인입니다.":"실행을 요청했습니다. 안건에서 실제 연결과 결과를 확인하세요.");setDraft(null);setInput("");setParent(null);request.current=null;await refresh();}catch(e){const status=(e as {status?:number}).status;if(draft.kind!=="announcement"&&(!status||status>=500)){setUnknown(true);setNotice("실행 결과가 아직 미확인입니다. 중복 실행하지 말고 안건 상태를 확인해주세요.");}else if(draft.kind==="development"){setNotice(codeError((e as Error).message));if(/expired|changed|digest|scope/.test((e as Error).message)){setDraft(null);request.current=null;}}else setNotice(officeRequestError((e as Error).message));}finally{setBusy(false);}}
  async function accept(t:OfficeRoomTask){if(!t.reportHash||busy||!window.confirm("이 보고서를 읽고 확인 완료로 기록할까요? 새 AI 업무·개발·배포는 시작하지 않습니다."))return;setBusy(true);try{await api("/control-api/tasks/"+encodeURIComponent(t.id)+"/accept",{reportHash:t.reportHash,confirmation:true});setNotice("보고서 확인을 기록했습니다.");await refresh();}catch{setNotice("보고서가 변경됐거나 완료 조건을 확인하지 못했습니다. 새로 불러와 다시 읽어주세요.");}finally{setBusy(false);}}
  function meetingReason(code:string){return ({office_meeting_source_changed:'회의 중 자료가 바뀌어 멈췄어요. 새 자료로 다시 검토할지 확인해주세요.',office_meeting_membership_changed:'참여자나 실행 설정이 바뀌어 재확인이 필요해요.',office_meeting_child_not_successful:'팀장 검토가 끝나지 않아 다음 순서를 멈췄어요. 해당 안건 결과를 확인해주세요.',office_wait_for_running_task:'다른 업무가 끝나기를 기다리고 있어요.',office_provider_not_ready:'사무실 AI 로그인과 실행 준비를 확인해주세요.',office_meeting_reports_too_long:'의견이 길어 종합 정리를 멈췄어요. 각 팀장 보고서를 읽고 질문 범위를 좁혀주세요.'} as Record<string,string>)[code]||'실행 결과를 확인해야 해요. 같은 회의를 반복해서 시작하지 마세요.';}
  async function connectAll(){if(!projectId||teamBusy)return;setTeamBusy(true);try{const result=await api('/control-api/team/connect',{projectId,confirmation:true});setNotice(result.skipped?.length?'기존 계정 연결이 있는 직원은 보존했습니다. 아래 연결 상태를 확인해주세요.':'전체 직원의 실행 연결을 설정했습니다. 실제 답변은 각 업무 결과로 확인합니다.');await refresh();document.getElementById('office-team-state')?.removeAttribute('open');}catch{setNotice('연결하지 못했습니다. 진행 중 업무를 먼저 마치고 사무실 ChatGPT 로그인 상태를 확인해주세요. 기존 인증과 데이터는 보존했습니다.');}finally{setTeamBusy(false);}}
  async function resumeMeeting(m:OfficeMeeting){if(!window.confirm('참여 팀장 '+m.participants.map(p=>p.name).join(', ')+'\n남은 AI 작업은 최대 '+Math.max(0,m.maxCalls-m.completedCalls)+'건입니다. 이어서 진행할까요?'))return;setTeamBusy(true);try{await api('/control-api/team/meetings/start',{id:m.id,digest:m.digest,confirmation:true});await refresh();}catch{setNotice('회의 상태나 자료가 바뀌어 이어서 진행하지 못했습니다. 확인 후 새 회의가 필요한지 살펴봐주세요.');}finally{setTeamBusy(false);}}
  async function stopMeeting(m:OfficeMeeting){if(!window.confirm('이 회의의 진행 중 검토와 이후 순서를 중지할까요? 이미 받은 결과는 보존합니다.'))return;setTeamBusy(true);try{await api('/control-api/team/meetings/stop',{id:m.id,confirmation:true});await refresh();}catch{setNotice('중지 여부를 아직 확인하지 못했습니다. 같은 회의를 새로 시작하지 말고 상태를 확인해주세요.');}finally{setTeamBusy(false);}}
  function codeError(code:string){
    if(/github_login_required|gh_auth/.test(code))return 'GitHub 계정 연결이 필요해요. 맥의 GitHub 연결 파일로 본인 계정을 연결한 뒤 다시 확인해주세요.';
    if(/runtime_update|development.*unavailable|development.*disabled|capability/.test(code))return '사무실의 코드 수정 연결 업데이트가 필요해요. 최신 개발 연결 파일을 적용해주세요.';
    if(/running_task|busy|locked|active/.test(code))return '다른 업무가 진행 중이에요. 기존 업무가 끝난 뒤 다시 확인해주세요.';
    if(/expired|changed|digest|scope/.test(code))return '요청이나 코드가 바뀌었어요. 최신 결과를 다시 확인하고 승인해주세요.';
    if(/agent|assignment/.test(code))return '이 프로젝트에 연결된 개발 담당자가 필요해요. 받는 사람을 전체 대화로 바꾸거나 개발 담당자를 연결해주세요.';
    if(/validation|test|dependency|sandbox/.test(code))return '검사를 완료하지 못했어요. 검사 결과와 필요한 준비를 확인해주세요. 기존 코드는 반영하지 않았어요.';
    if(/render|deployment|workflow/.test(code))return '배포 연결이나 GitHub 실행 상태를 확인해야 해요. 배포 완료로 처리하지 않았어요.';
    return '처리 결과를 확인해야 해요. 기존 작업은 유지했어요. 아래 결과를 새로 확인해주세요.';
  }
  const releaseView=(r:OfficeRelease):OfficeRelease=>{if(!r.deployment)return r;const live=r.deployment.liveConfirmed===true&&r.deployment.status==='live'&&!!r.commit&&r.deployment.commit===r.commit;return {...r,state:live?'deploy_live':r.deployment.status==='checks_or_deployment_failed'?'deploy_failed':r.deployment.status==='running'?'deploy_running':r.deployment.requested?'deploy_requested':'inspection_required',liveConfirmed:live,url:r.deployment.url};};
  useEffect(()=>{if(!codeOpen||!release?.deployment?.requested||!['deploy_requested','deploy_running'].includes(release.state))return;let active=true,pending=false;const id=release.id;const timer=setInterval(async()=>{if(pending||document.visibilityState!=='visible')return;pending=true;try{const result=await api('/control-api/releases/'+encodeURIComponent(id));if(active)setRelease(current=>current?.id===id?releaseView(result):current);}catch{/* Preserve the last verified status; manual refresh remains available. */}finally{pending=false;}},5000);return()=>{active=false;clearInterval(timer);};},[api,codeOpen,release?.id,release?.state,release?.deployment?.requested]);
  const codeProgress=(d:OfficeDevelopment)=>release?.requestId===d.id&&['deploy_requested','deploy_running','deploy_live','deploy_failed'].includes(release.state)?releaseState(release):release?.requestId===d.id&&release.state==='pushed'?'GitHub 반영 완료':d.taskStatus==='in_progress'?'코드 수정 중':d.candidateAvailable?'수정 결과 도착 · 검사 대기':d.state==='prepared'?'실행 확인 대기':d.state==='inspection_required'?'실행 상태 확인 필요':d.taskStatus==='review'?'결과 도착 · 완료 조건 확인 필요':d.state==='started'?'실행 요청됨 · 상태 확인 중':'상태 확인 필요';
  const releaseState=(r:OfficeRelease)=>({validating:'검사 중',validated:'검사 통과 · 반영 승인 대기',validation_failed:'검사 실패 · 원본 반영 안 됨',blocked:'연결 또는 준비 필요',pushed:'GitHub 반영 완료 · 배포 전',inspection_required:'처리 결과 확인 필요',deploy_requested:'배포 요청됨 · 완료 확인 전',deploy_running:'배포 진행 중 · 공개 완료 확인 전',deploy_live:'운영 사이트 반영 완료',deploy_failed:'배포 검사 또는 실행 실패 · 진행 기록 확인 필요'} as Record<string,string>)[r.state]||'결과 확인 필요';
  const blockerText=(code:string)=>({github_login_required:'GitHub 계정 연결 필요',render_connection_required:'Render 배포 계정 연결 필요',validation_failed:'검사를 통과하지 못함',dependencies_missing:'검사에 필요한 설치 파일 준비 필요'} as Record<string,string>)[code]||codeError(code);
  async function checkSource(){if(!projectId||codeBusy)return;setCodeBusy(true);try{const latest=await api('/control-api/development/source?projectId='+encodeURIComponent(projectId));if(latest.upToDate)setNotice('현재 프로젝트가 GitHub의 최신 코드와 같아요.');else setSourcePreview(latest);}catch(e){setNotice(codeError((e as Error).message));}finally{setCodeBusy(false);}}
  async function syncSource(){if(!sourcePreview||codeBusy)return;setCodeBusy(true);try{const r=await api('/control-api/development/source/sync',{projectId:sourcePreview.projectId,expectedHead:sourcePreview.sourceHead,expectedRemoteHead:sourcePreview.remoteHead,digest:sourcePreview.digest,confirmation:true},120000);setSourcePreview(null);setNotice(r.knowledgeReady===false?'최신 코드를 받았어요. 제품 문서 연결을 갱신한 뒤 다음 업무를 시작할 수 있어요.':'최신 코드를 받았어요. 다음 코드 수정은 이 버전을 기준으로 시작합니다.');await refresh();}catch(e){setNotice(codeError((e as Error).message));}finally{setCodeBusy(false);}}
  async function inspectCode(id:string){if(codeBusy)return;setCodeBusy(true);setCodeUnknown(false);setDiffRead(false);setRelease(null);try{setCodeResult(await api('/control-api/development/'+encodeURIComponent(id)));const saved=await api('/control-api/releases?requestId='+encodeURIComponent(id));if(Array.isArray(saved.releases)&&saved.releases.length){setRelease(releaseView(saved.releases[0]));setRelease(releaseView(await api('/control-api/releases/'+encodeURIComponent(saved.releases[0].id))));}}catch(e){setNotice(codeError((e as Error).message));}finally{setCodeBusy(false);}}
  async function validateCode(){if(!codeResult||codeBusy||codeUnknown)return;setCodeBusy(true);setDiffRead(false);setNotice('수정한 파일을 검사하고 있어요. 검사 결과를 받은 뒤 반영할 수 있어요.');try{const r=await api('/control-api/development/'+encodeURIComponent(codeResult.id)+'/validate',{},120000);setRelease(releaseView(r));setNotice(r.state==='validated'?'검사를 통과했어요. 변경 내용을 확인한 뒤 GitHub에 반영할 수 있어요.':'검사 결과를 확인해주세요. 아직 원본에는 반영하지 않았어요.');}catch(e){setCodeUnknown(true);setNotice('검사 완료 여부를 아직 확인하지 못했어요. 다시 실행하기 전에 결과 새로 확인을 눌러주세요.');}finally{setCodeBusy(false);}}
  async function publishCode(){if(!release?.digest||release.state!=='validated'||!diffRead||release.diffTruncated||codeBusy||codeUnknown)return;if(!window.confirm('지금 확인한 수정본을 GitHub main에 반영할까요? 운영 사이트 배포는 다음 단계에서 따로 확인합니다. 앱 변경이 있으면 기존 TestFlight 자동 빌드·제출도 시작될 수 있어요.'))return;setCodeBusy(true);try{const r=await api('/control-api/releases/'+encodeURIComponent(release.id)+'/publish',{digest:release.digest,confirmation:true},120000);setRelease(releaseView(r));setNotice(r.state==='pushed'?'GitHub에 반영했어요. 운영 사이트 배포는 아래에서 별도로 시작하세요.':'반영 결과를 확인해야 해요. 자동으로 다시 전송하지 않습니다.');if(r.state!=='pushed')setCodeUnknown(true);}catch(e){const code=(e as Error).message;if(/github_login_required|confirmation_expired|candidate_changed|source_changes_preserved|remote_changed/.test(code)){setDiffRead(false);setNotice(codeError(code));}else{setCodeUnknown(true);setNotice('GitHub 반영 결과가 미확인이에요. 다시 반영하지 말고 결과 새로 확인을 눌러주세요.');}}finally{setCodeBusy(false);}}
  async function deployCode(){if(!release?.deployDigest||release.state!=='pushed'||codeBusy||codeUnknown)return;if(!window.confirm('이 수정본을 운영 사이트에 배포할까요? 사용자가 보는 사이트가 변경됩니다.'))return;setCodeBusy(true);try{const r=await api('/control-api/releases/'+encodeURIComponent(release.id)+'/deploy',{digest:release.deployDigest,confirmation:true},120000);setRelease(old=>old?releaseView({...old,deployment:r}):old);if(!r.requested)setCodeUnknown(true);setNotice(r.requested?'배포를 요청했어요. 이 화면에서 진행 상태를 확인하고 있어요.':'배포 요청 상태를 확인해주세요.');}catch(e){const code=(e as Error).message;if(/github_login_required|render_connection_required|deploy_confirmation_required|remote_changed/.test(code))setNotice(codeError(code));else{setCodeUnknown(true);setNotice('배포 요청 결과가 미확인이에요. 중복 요청하지 말고 결과 새로 확인을 눌러주세요.');}}finally{setCodeBusy(false);}}
  return <div data-office-native-room aria-busy={busy||teamBusy||codeBusy} className="fixed inset-0 z-50 flex h-full w-full flex-col bg-gray-900 shadow-2xl lg:relative lg:inset-auto lg:z-auto lg:w-[min(520px,48vw)] lg:border-l lg:border-gray-700" onScrollCapture={e=>{const el=e.target as HTMLElement;if(messagesEndRef.current&&el.contains(messagesEndRef.current)&&el.scrollHeight>el.clientHeight+30&&el.tagName!=="TEXTAREA")autoStick.current=el.scrollHeight-el.clientHeight-el.scrollTop<80;}}>
    <ChatPanelHeader selectedAgent={contact} selectedDeptName={contact?"직원 대화":"전체 대화"} spriteMap={spriteMap} tr={headerTr} getAgentName={getName} getRoleLabel={role=>ROLE_LABELS[role as keyof typeof ROLE_LABELS]?.ko||role} getStatusLabel={a=>a==="working"?"작업 중":"기록 보기"} statusColors={STATUS_COLORS} showAnnouncementBanner={false} visibleMessagesLength={visibleMessages.length} onClose={onClose}/>
    <div className="flex shrink-0 flex-wrap items-center gap-2 border-b border-gray-700 p-2 text-sm"><button className="rounded border px-3 py-2" onClick={()=>{setWhole(true);setTargetId("");setParent(null);}}>전체 대화</button>{selectedAgent&&<button className="rounded border px-3 py-2" onClick={()=>{setWhole(false);setTargetId(selectedAgent?.id||"");}}>{getName(selectedAgent)} 대화</button>}<button className="rounded border px-3 py-2" onClick={()=>{setAgenda(v=>!v);setCodeOpen(false);}}>안건 {visibleTasks.length}</button><button className="rounded border px-3 py-2" onClick={()=>{setCodeOpen(v=>!v);setAgenda(false);}}>코드 수정·배포 {development.filter(d=>d.projectId===projectId).length}</button><label className="sr-only" htmlFor="native-room-project">프로젝트</label><select id="native-room-project" aria-label="프로젝트" className="min-w-0 rounded bg-gray-800 px-2 py-2" value={projectId} onChange={e=>{setProjectId(e.target.value);setParent(null);setCodeResult(null);setRelease(null);setDiffRead(false);setCodeUnknown(false);}}>{projects.map(p=><option key={p.id} value={p.id}>{p.name}</option>)}</select><span className="text-xs text-gray-400">{checkedAt?"상태 확인 "+new Date(checkedAt).toLocaleTimeString("ko-KR"):"연결 확인 중"}</span></div>
    <div className="shrink-0 border-b border-gray-700 px-3 py-2 text-sm"><label htmlFor="office-recipient">받는 사람</label><select id="office-recipient" aria-label="받는 사람" className="ml-2 max-w-[70%] rounded bg-gray-800 p-2" value={targetId} onChange={e=>{setTargetId(e.target.value);setParent(null);if(e.target.value==="@meeting"&&mode==="chat")setMode("question");}}><option value="">전체 대화 · 기본 검토 담당</option><option value="@meeting">팀장회의 · 여러 팀장 의견 모으기</option><optgroup label="팀장">{agents.filter(a=>a.role==='team_leader').map(a=><option key={a.id} value={a.id}>{getName(a)} · {departmentName(a.department_id)} 팀장</option>)}</optgroup><optgroup label="직원">{agents.filter(a=>a.role!=='team_leader').map(a=><option key={a.id} value={a.id}>{getName(a)}</option>)}</optgroup></select><details id="office-team-state" className="mt-2"><summary>직원 연결 상태 {team?team.readyCount+'/'+team.total:'확인 중'}</summary><p className="my-2 text-xs">실행할 준비와 실제 답변은 달라요. 각 직원의 최근 업무 기록을 함께 표시합니다.</p><button disabled={teamBusy} className="rounded border px-3 py-2" onClick={()=>void connectAll()}>{teamBusy?'연결 확인 중…':'전체 직원 연결'}</button><div className="max-h-40 overflow-y-auto">{team?.roster.map(r=><p key={r.id} className="mt-1 text-xs">{r.name} · {r.ready?'업무 준비됨':r.blockedReason==='existing_account_binding_preserved'?'기존 계정 연결 보존 · 별도 확인 필요':r.configured?'로그인·실행 환경 확인 필요':'실행 연결 필요'} · {r.lastExecution?.verified?'실제 답변 기록 있음':'답변 완료 미확인'}</p>)}</div></details></div>
    <div className="max-h-48 shrink-0 overflow-y-auto">{!codeOpen&&team?.meetings.filter(m=>m.projectId===projectId).map(m=><details key={m.id} className="mx-3 my-1 shrink-0 rounded border border-gray-700 px-2 py-1 text-sm"><summary>팀장회의 · {m.title} · {m.state==='completed'?'종합 보고서 도착':m.resumeRequired?'재시작 후 대기':m.state==='running'?'검토 진행 중':m.state==='prepared'?'시작 확인 대기':m.state==='paused'?'잠시 대기':m.state==='stopped'?'중지됨':'진행 확인 필요'} · {m.completedCalls}/{m.maxCalls}</summary><p className="my-1 text-xs">{m.participants.map(p=>p.name+'('+departmentName(p.department)+')').join(' · ')}</p>{m.finalTaskId&&<button className="my-2 rounded border p-2" onClick={()=>{setAgenda(true);setTimeout(()=>{const item=document.getElementById('office-task-'+m.finalTaskId);if(item){item.setAttribute('open','');item.scrollIntoView({block:'nearest'});}},80);}}>종합 보고서 보기</button>}{m.children?.map(c=><p key={c.taskId||c.agentId} className="text-xs">{c.name}{c.kind==='synthesis'?' · 종합 정리':''}: {m.state==='stopped'&&c.state==='prepared'?'회의 중지로 실행하지 않음':c.state==='completed'?'실제 의견 도착':c.state==='running'?'실행 중 표시':c.state==='prepared'?'차례 대기':'확인 필요'}</p>)}{m.errorCode&&<p role="status" className="my-2 text-sm text-amber-300">{meetingReason(m.errorCode)}</p>}{(m.resumeRequired||m.state==='paused'||m.state==='prepared')&&<button disabled={teamBusy} onClick={()=>void resumeMeeting(m)} className="mr-2 rounded border p-2">확인하고 이어서 진행</button>}{(!['completed','stopped','failed'].includes(m.state)||!!m.currentTaskId)&&<button disabled={teamBusy} onClick={()=>void stopMeeting(m)} className="rounded border p-2">회의 중지</button>}</details>)}</div>
    {codeOpen&&<section aria-label="코드 수정과 배포" className="max-h-[25vh] shrink-0 overflow-y-auto border-b border-gray-700 p-3 text-sm"><p className="mb-2">수정 요청 → 결과 검사 → GitHub 반영 → 운영 사이트 배포</p><button disabled={codeBusy||!projectId} className="mb-2 rounded border p-2" onClick={()=>void checkSource()}>최신 코드 확인</button>{!development.some(d=>d.projectId===projectId)&&<p>아래에서 코드 수정을 선택하고 바꾸고 싶은 내용을 적어주세요.</p>}{development.filter(d=>d.projectId===projectId).map(d=><div key={d.id} className="mb-2 rounded border border-gray-700 p-2"><p className="font-semibold">{d.title}</p><p className="my-1 text-xs">{codeProgress(d)}</p><button disabled={codeBusy} className="rounded border p-2" onClick={()=>void inspectCode(d.id)}>수정 결과 보기</button>{d.state==='prepared'&&d.expiresAt>Date.now()&&<button disabled={busy} className="ml-2 rounded border p-2" onClick={()=>{setDraft({...d,kind:'development',agentName:getName(agents.find(a=>a.id===d.agentId))});setUnknown(false);}}>실행 내용 확인</button>}{d.state==='prepared'&&d.expiresAt<=Date.now()&&<button disabled={busy} className="ml-2 rounded border p-2" onClick={()=>{setInput(d.prompt);setMode('development');setTargetId(d.agentId);request.current=null;setNotice('확인 시간이 지나 새 요청으로 준비합니다. 아래 전송을 눌러 내용을 다시 확인해주세요.');textareaRef.current?.focus();}}>새 요청으로 준비</button>}</div>)}{codeResult&&<article className="mt-3 rounded border border-blue-400 p-3"><h3 className="font-bold">{codeResult.title}</h3><p className="my-2">{codeProgress(codeResult)}</p>{codeResult.result&&<FriendlyOfficeReport content={codeResult.result}/>}<div className="my-2 flex flex-wrap gap-2"><button disabled={codeBusy} className="rounded border p-2" onClick={()=>void inspectCode(codeResult.id)}>결과 새로 확인</button>{codeResult.candidateAvailable&&<button disabled={codeBusy||codeUnknown} className="rounded border p-2" onClick={()=>void validateCode()}>수정본 검사하기</button>}</div>{codeBusy&&<p role="status">처리 중입니다. 완료 결과를 기다려주세요.</p>}{release&&<div data-office-release><h4 className="mt-3 font-semibold">{releaseState(release)}</h4>{(release.humanSummary||release.summary)&&<p className="my-2 whitespace-pre-wrap">{release.humanSummary||release.summary}</p>}{release.tests?.length?<ul className="my-2 list-disc pl-5">{release.tests.map((check,i)=><li key={i}>{check.name}: {check.passed?'통과':'통과하지 못함'}</li>)}</ul>:<p className="my-2">확인된 검사 결과가 아직 없습니다.</p>}{release.blockers?.map((code,i)=><p key={i} className="my-2 text-amber-300">{blockerText(code)}</p>)}{release.files?.length?<details className="my-2"><summary>변경 파일 {release.files.length}개</summary><ul className="break-all">{release.files.map(file=>{const name=typeof file==='string'?file:file.path;return <li key={name}>{name}{typeof file==='string'?'':file.status==='added'?' · 추가':file.status==='deleted'?' · 삭제':' · 수정'}</li>;})}</ul></details>:null}{release.diff&&<details className="my-2"><summary>실제 코드 변경 내용</summary><pre className="max-h-56 overflow-auto rounded bg-black/30 p-2 text-xs">{release.diff}</pre></details>}{release.diffTruncated&&<p className="my-2 text-amber-300">변경 내용 전체를 표시하지 못했어요. 전체 내용을 검토하기 전에는 반영할 수 없습니다.</p>}{release.state==='validated'&&<><label className="my-2 flex items-start gap-2"><input type="checkbox" checked={diffRead} disabled={!release.diff||release.diffTruncated} onChange={e=>setDiffRead(e.target.checked)}/><span>검사 결과와 실제 변경 내용을 확인했어요.</span></label><button disabled={codeBusy||codeUnknown||!diffRead||!release.diff||release.diffTruncated} className="rounded bg-blue-600 p-2 text-white disabled:opacity-40" onClick={()=>void publishCode()}>확인한 수정본을 GitHub에 반영</button></>}{release.githubUrl&&/^https:\/\/github\.com\//.test(release.githubUrl)&&<a className="my-2 block underline" href={release.githubUrl} target="_blank" rel="noreferrer">GitHub 반영 내용 보기</a>}{release.state==='pushed'&&<button disabled={codeBusy||codeUnknown||!release.deployDigest} className="mt-2 rounded bg-blue-600 p-2 text-white disabled:opacity-40" onClick={()=>void deployCode()}>이 수정본을 운영 사이트에 배포</button>}{release.url&&/^https:\/\/github\.com\//.test(release.url)&&<a className="my-2 block underline" href={release.url} target="_blank" rel="noreferrer">배포 진행 확인</a>}{release.state==='deploy_requested'&&<p>배포 요청을 접수했어요. 실제 공개 완료는 아직 확인 전입니다.</p>}{release.state==='deploy_running'&&<p>검사와 배포를 진행하고 있어요. 완료 상태를 자동으로 확인합니다.</p>}{release.state==='deploy_live'&&<p>승인한 수정본이 운영 사이트에 공개된 것을 확인했어요.</p>}{release.state==='deploy_failed'&&<p>완료되지 않았어요. 배포 진행 확인에서 원인을 확인해주세요. 자동으로 다시 배포하지 않습니다.</p>}</div>}</article>}</section>}
    {agenda&&<section aria-label="안건 목록" className="max-h-72 shrink-0 overflow-y-auto border-b border-gray-700 p-3 text-sm">{!visibleTasks.length&&<p>등록된 안건이 없습니다.</p>}{visibleTasks.map(t=><details id={"office-task-"+t.id} key={t.id} className="mb-2 rounded border border-gray-700 p-2"><summary>{t.title} · {progress(t)}</summary><p className="my-2 text-xs">담당: {t.agent.name}</p><p className="whitespace-pre-wrap">{(t.request as {displayPrompt?:string})?.displayPrompt||t.request?.prompt}</p>{t.result?<div className="my-2 max-h-72 overflow-y-auto"><MessageContent content={t.result}/></div>:<p>아직 저장된 보고서가 없습니다.</p>}{t.status==='in_progress'&&<button disabled={busy} className="rounded border px-3 py-2" onClick={async()=>{const meeting=team?.meetings.find(m=>m.currentTaskId===t.id);if(meeting){await stopMeeting(meeting);return;}if(!window.confirm('이 업무를 중지할까요? 저장된 내용은 보존합니다.'))return;setBusy(true);try{await api('/control-api/tasks/'+encodeURIComponent(t.id)+'/stop',{confirmation:true});await refresh();}catch{setNotice('중지 여부를 확인하지 못했습니다. 상태를 다시 확인해주세요.');}finally{setBusy(false);}}}>중지</button>}{t.status==="review"&&t.result&&t.reportEligible&&<button disabled={busy} className="rounded border px-3 py-2" onClick={()=>void accept(t)}>보고서 확인 완료</button>}{["review","done"].includes(t.status)&&t.result&&<button className="ml-2 rounded border px-3 py-2" onClick={()=>{setParent(t.id);setProjectId(t.project_id);setTargetId(t.agent.id||"");setMode("question");setAgenda(false);textareaRef.current?.focus();}}>이 안건에 추가 요청</button>}{['review','done'].includes(t.status)&&t.result&&<button className="ml-2 rounded border px-3 py-2" onClick={()=>{setParent(t.id);setProjectId(t.project_id);setTargetId(t.agent.id||"");setMode('question');setInput('이 보고서를 쉬운 말로 다시 설명해줘. 결론, 지금 할 일, 내가 결정할 것만 먼저 알려줘.');setAgenda(false);textareaRef.current?.focus();}}>쉽게 다시 설명받기</button>}</details>)}</section>}
    {cursor&&<button className="shrink-0 py-2 text-sm" disabled={loadingOlder} onClick={async()=>{setLoadingOlder(true);try{await refresh(cursor);}finally{setLoadingOlder(false);}}}>이전 대화 더 보기</button>}
    <ChatMessageList selectedAgent={contact} visibleMessages={visibleMessages} agents={agents} spriteMap={spriteMap} locale={locale} tr={tr} getAgentName={getName} decisionRequestByMessage={new Map()} decisionReplyKey={null} onDecisionOptionReply={()=>{}} onDecisionManualDraft={()=>{}} streamingMessage={null} messagesEndRef={messagesEndRef}/>
    {notice&&<p role="status" className="shrink-0 whitespace-pre-wrap px-3 py-2 text-sm text-amber-300">{notice}</p>}{parent&&<button className="shrink-0 px-3 text-left text-xs" onClick={()=>setParent(null)}>이전 안건에 추가 요청 중 · 눌러 해제</button>}
    <p className="shrink-0 px-3 text-xs text-gray-400">검토는 질문·업무 지시, 실제 파일 변경은 코드 수정을 선택하세요. 대화·공지는 저장만 하며 상대의 읽음은 미확인입니다.</p>
    <ChatComposer allowGlobalTasks mode={mode} input={input} selectedAgent={contact} isDirectiveMode={false} isAnnouncementMode={mode==="announcement"} tr={tr} getAgentName={getName} textareaRef={textareaRef} onModeChange={next=>{setMode(next);if(next==="development"){setCodeOpen(true);setAgenda(false);if(targetId==="@meeting")setTargetId("");}}} onInputChange={setInput} onSend={()=>void send()} onKeyDown={e=>{if(e.key==="Enter"&&!e.shiftKey&&!e.nativeEvent.isComposing){e.preventDefault();void send();}}}/>
    {sourcePreview&&<div role="dialog" aria-label="최신 코드 받기 확인" aria-modal="true" className="absolute inset-0 z-10 flex items-center justify-center bg-black/70 p-3"><div className="w-full rounded-xl border border-gray-600 bg-gray-900 p-4"><h2 className="text-lg font-bold">GitHub의 최신 코드를 받을까요?</h2><p className="my-3 text-sm">다음 작업의 기준을 최신 버전으로 맞춥니다. 편집 중인 파일이나 진행 중 업무와 충돌하면 기존 내용을 보존하고 멈춥니다.</p><details className="my-3 break-all text-xs"><summary>확인한 코드 버전</summary><p>현재: {sourcePreview.sourceHead}</p><p>받을 버전: {sourcePreview.remoteHead}</p></details>{notice&&<p role="status" className="my-2 text-sm text-amber-300">{notice}</p>}<button disabled={codeBusy} className="mr-2 rounded border p-2" onClick={()=>setSourcePreview(null)}>취소</button><button disabled={codeBusy} className="rounded bg-blue-600 p-2 text-white" onClick={()=>void syncSource()}>{codeBusy?'확인 중…':'확인하고 최신 코드 받기'}</button></div></div>}
    {draft&&<div role="dialog" aria-label="안건 실행 확인" aria-modal="true" className="absolute inset-0 z-10 flex items-center justify-center bg-black/70 p-3"><div className="max-h-full w-full overflow-y-auto rounded-xl border border-gray-600 bg-gray-900 p-4"><h2 className="text-lg font-bold">{draft.kind==="development"?"코드 수정 시작 확인":draft.kind==="meeting"?"팀장회의 시작 확인":draft.kind==="announcement"?"공지 저장 확인":"안건 등록됨 · 실행 내용 확인"}</h2><p className="my-2 text-sm">{draft.kind==="development"?"담당: "+(draft.agentName||"개발 담당자")+" · 별도 작업 사본에서 코드를 수정합니다. 원본 반영·배포는 결과 확인 뒤 따로 승인합니다.":draft.kind==="announcement"?"AI 실행 없이 저장합니다.":"담당: "+(draft.agentName||"검토 담당자")+" · 읽기 전용 검토"}</p>{draft.kind==="meeting"&&<p className="my-2 text-sm">참여: {draft.participants?.map(p=>p.name).join(" · ")}<br/>AI 작업 최대{draft.maxCalls}건 · 팀장 의견 후 종합 정리 · 사용량을 소비합니다.</p>}<pre className="my-3 whitespace-pre-wrap break-words font-sans text-sm">{draft.prompt}</pre>{notice&&<p role="status" className="my-2 text-sm text-amber-300">{notice}</p>}<button disabled={busy} className="mr-2 rounded border px-3 py-2" onClick={()=>setDraft(null)}>닫기</button><button disabled={busy||unknown} className="rounded bg-blue-600 px-3 py-2 text-white" onClick={()=>void execute()}>{busy?"처리 중…":draft.kind==="announcement"?"확인하고 공지 저장":"확인하고 실행"}</button></div></div>}
  </div>;
}
