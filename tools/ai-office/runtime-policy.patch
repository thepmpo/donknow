+    const parent = path.join(policy.source, ".climpire-worktrees"),
+      prefix = id(taskId).slice(0, 8),
+      name = path.basename(working);
+    if (path.dirname(working) !== parent || ![prefix, prefix + "-1", prefix + "-2", prefix + "-3"].includes(name))
+      fail("office_development_cwd_mismatch");
+    if (
+      git(working, "rev-parse", "HEAD") !== policy.head ||
+      real(git(working, "rev-parse", "--absolute-git-dir")) !== path.join(policy.source, ".git", "worktrees", name)
+    )
+      fail("office_worktree_head_mismatch");
+  }
+  for (let ancestor = working; inside(ancestor, policy.source); ancestor = path.dirname(ancestor)) {
+    denyProjectConfiguration(ancestor);
+    if (ancestor === policy.source) break;
+  }
+  const targetHome = real(os.homedir());
+  if (inside(policy.source, targetHome) || inside(targetHome, policy.source)) fail("office_home_project_overlap");
+  const runner = officeRunner();
+  const authHome = validateChatGptAuth(policy.source);
+  probeOfficeSandbox();
+  const args = ["bwrap", "--die-with-parent", "--new-session", "--unshare-pid", "--unshare-ipc", "--unshare-uts"];
+  for (const mount of ["/usr", "/bin", "/sbin", "/lib", "/lib64", "/opt", "/etc/ssl", "/etc/hosts", "/etc/resolv.conf"])
+    if (fs.existsSync(mount)) args.push("--ro-bind", mount, mount);
+  args.push(
+    "--proc",
+    "/proc",
+    "--dev",
+    "/dev",
+    "--tmpfs",
+    "/tmp",
+    "--tmpfs",
+    targetHome,
+    "--dir",
+    path.join(targetHome, ".codex"),
+    "--ro-bind",
+    path.join(authHome, ".codex", "auth.json"),
+    path.join(targetHome, ".codex", "auth.json"),
+    "--ro-bind",
+    policy.source,
+    policy.source,
+  );
+  if (policy.phase === "development") args.push("--bind", working, working);
+  const knowledge = officeKnowledge(policy.projectPath);
+  if (knowledge) args.push("--ro-bind", knowledge.directory, "/run/office-knowledge");
+  args.push("--ro-bind", runner.bundle, "/run/office-provider");
+  args.push(
+    "--chdir",
+    working,
+    "/run/office-provider/bin/codex",
+    ...officeCliArgs(policy.phase, model, reasoning).slice(1),
+  );
+  return { args, policy };
+}
+export function installOfficePolicyRoutes(app: any, input: any): void {
+  configureOfficePolicy(input);
+  const wrap = (fn: (req: any, res: any) => void) => (req: any, res: any) => {
+    try {
+      fn(req, res);
+    } catch (e: any) {
+      res.status(e.status || 500).json({ error: e.code || "office_policy_error" });
+    }
+  };
+  const owner = (req: any) => {
+    const key = process.env.AI_OFFICE_OWNER_KEY;
+    if (!key || !same(req.headers["x-office-owner-key"], key)) fail("office_owner_confirmation_required");
+  };
+  app.use((req: any, res: any, next: any) => {
+    if (!officePolicyEnabled() || ["GET", "HEAD", "OPTIONS"].includes(req.method)) return next();
+    const p = req.path.replace(/\/+$/, "");
+    if (
+      [
+        "/api/inbox",
+        "/api/messages",
+        "/api/github/clone",
+        "/api/skills/learn",
+        "/api/skills/unlearn",
+        "/api/update-apply",
+        "/api/update-auto-config",
+      ].includes(p) ||
+      /\/merge$/.test(p) ||
+      /^\/api\/agents\/[^/]+\/spawn$/.test(p)
+    )
+      return res.status(403).json({ error: "office_unscoped_execution_blocked" });
+    const run = /^\/api\/tasks\/([^/]+)\/run$/.exec(p);
+    if (run) {
+      try {
+        requireOfficeWorker(run[1]);
+      } catch (e: any) {
+        return res.status(e.status || 403).json({ error: e.code || "office_policy_error" });
+      }
+    }
+    next();
+  });
+  app.get(
+    "/api/office-policy/status",
+    wrap((_req, res) =>
+      res.json({
+        enabled: officePolicyEnabled(),
+        workersEnabled: process.env.AI_OFFICE_WORKERS_ENABLED === "true",
+        knowledgeEnabled: process.env.AI_OFFICE_KNOWLEDGE_ENABLED === "true",
+        developmentEnabled: process.env.AI_OFFICE_DEVELOPMENT_ENABLED === "true",
+        ...diagnoseOfficeProvider(),
+        ownerConfigured: !!process.env.AI_OFFICE_OWNER_KEY,
+        permissionTtlMs: TTL,
+        automaticMerge: false,
+        unscopedExecution: false,
+        provider: "codex",
+      }),
+    ),
+  );
+  app.post(
+    "/api/office-policy/runtime/check",
+    wrap((req, res) => {
+      owner(req);
+      res.json(checkOfficeProviderSandbox());
+    }),
+  );
+  app.post(
+    "/api/office-policy/runtime/product-unlock",
+    wrap((req, res) => {
+      owner(req);
+      res.json(unlockOfficeProductWorkers(req.body?.confirmation));
+    }),
+  );
+  app.post(
+    "/api/office-policy/runtime/lock",
+    wrap((req, res) => {
+      owner(req);
+      res.json(lockOfficeWorkers());
+    }),
+  );
+  app.post(
+    "/api/office-policy/tasks/:id/prepare",
+    wrap((req, res) => {
+      owner(req);
+      res.json(prepareOfficeTask(req.params.id, req.body?.phase));
+    }),
+  );
+  app.post(
+    "/api/office-policy/tasks/:id/approve",
+    wrap((req, res) => {
+      owner(req);
+      res.json(approveOfficeTask(req.params.id, req.body?.expectedDigest, req.body?.confirmation));
+    }),
+  );
+  app.post(
+    "/api/office-policy/tasks/:id/revoke",
+    wrap((req, res) => {
+      owner(req);
+      revokeOfficeTask(req.params.id);
+      res.json({ revoked: true });
+    }),
+  );
+}
