diff --git a/scripts/office-sandbox-smoke.ts b/scripts/office-sandbox-smoke.ts
new file mode 100644
index 0000000..bb653a5
--- /dev/null
+++ b/scripts/office-sandbox-smoke.ts
@@ -0,0 +1,229 @@
+/** Host containment check only: fixture permissions, shell probes, no AI calls or real account state. */
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { execFileSync, spawnSync } from "node:child_process";
+import { createHash } from "node:crypto";
+import net from "node:net";
+import { DatabaseSync } from "node:sqlite";
+import {
+  configureOfficePolicy,
+  prepareOfficeTask,
+  approveOfficeTask,
+  officeSandboxCommand,
+  officeWorkerEnvironment,
+} from "../server/office-policy.ts";
+
+const nativeMode = process.argv.includes("--native-codex");
+const productOnly = process.argv.includes("--product-only");
+const configuredRunner = {
+  bundle: process.env.AI_OFFICE_CODEX_BUNDLE_DIR,
+  hash: process.env.AI_OFFICE_CODEX_SHA256,
+  root: process.env.AI_OFFICE_PROVIDER_BIN_ROOT,
+};
+const canary = net.createServer((socket) => socket.end());
+let canaryPort = 0;
+const temporary = fs.mkdtempSync(path.join(os.tmpdir(), "office-os-containment-"));
+const projects = path.join(temporary, "projects");
+const wrapper = path.join(projects, "fixture-project");
+const source = path.join(wrapper, "source");
+const otherProject = path.join(projects, "other-project");
+const fakeProviderHome = path.join(temporary, "fixture-provider-home");
+const database = new DatabaseSync(":memory:");
+const envKeys = [
+  "AI_OFFICE_POLICY_ENABLED",
+  "AI_OFFICE_WORKERS_ENABLED",
+  "AI_OFFICE_PROJECTS_ROOT",
+  "AI_OFFICE_PROVIDER_AUTH_DIR",
+  "AI_OFFICE_DEVELOPMENT_ENABLED",
+  "AI_OFFICE_CODEX_BUNDLE_DIR",
+  "AI_OFFICE_CODEX_SHA256",
+  "AI_OFFICE_PROVIDER_BIN_ROOT",
+];
+const previous = Object.fromEntries(envKeys.map((key) => [key, process.env[key]]));
+function git(...args: string[]): void {
+  execFileSync("git", args, { cwd: source, stdio: "pipe", timeout: 10000 });
+}
+function addTask(taskId: string, phase: "product" | "development"): void {
+  database
+    .prepare(
+      "INSERT INTO tasks VALUES (?, 'fixture task', 'fixture-only scope', 'general', 'fixture-agent', 'fixture-project', NULL, 'planning', 'development', NULL)",
+    )
+    .run(taskId);
+  const preview = prepareOfficeTask(taskId, phase);
+  approveOfficeTask(taskId, preview.digest, true);
+}
+const readOnlyScript = `
+set -eu
+test "$(cat "$1/README.md")" = "fixture source"
+if printf forbidden 2>/dev/null > "$1/must-not-write.txt"; then echo 'FAIL: product source writable'; exit 41; fi
+test ! -e "$3/other-project-sentinel.txt"
+test ! -e "$4/HANDOFF.md"
+test ! -e /workspace/ai-office-runtime/.env
+test ! -e /workspace/ai-office/state/office.sqlite
+test "$(cat "$HOME/.codex/auth.json")" = '{"auth_mode":"chatgpt","OPENAI_API_KEY":null,"tokens":{"access_token":"fixture-not-credential","refresh_token":"fixture-not-credential"}}'
+printf 'ephemeral cache' > "$HOME/.codex/fixture-cache.txt"
+if printf forbidden 2>/dev/null > "$HOME/.codex/auth.json"; then echo 'FAIL: auth fixture writable'; exit 44; fi
+printf 'PASS: product source readable and read-only; other project, wrapper handoff, office secrets and database absent\n'
+`;
+const developmentScript = `
+set -eu
+test "$(cat "$1/README.md")" = "fixture source"
+printf 'approved fixture edit' > "$2/approved-worker-output.txt"
+test "$(cat "$2/approved-worker-output.txt")" = 'approved fixture edit'
+if printf forbidden 2>/dev/null > "$1/must-not-write.txt"; then echo 'FAIL: development main source writable'; exit 42; fi
+if printf forbidden 2>/dev/null > "$1/.git/must-not-write.txt"; then echo 'FAIL: common git metadata writable'; exit 43; fi
+test ! -e "$3/other-project-sentinel.txt"
+test ! -e "$4/HANDOFF.md"
+test ! -e /workspace/ai-office-runtime/.env
+test ! -e /workspace/ai-office/state/office.sqlite
+printf 'ephemeral cache' > "$HOME/.codex/fixture-cache.txt"
+if printf forbidden 2>/dev/null > "$HOME/.codex/auth.json"; then echo 'FAIL: auth fixture writable'; exit 45; fi
+printf 'PASS: only approved development worktree writable; source and common git metadata read-only; other project and office state absent\n'
+`;
+function runProbe(taskId: string, cwd: string, script: string): void {
+  const launch = officeSandboxCommand(taskId, "codex", cwd);
+  const chdirIndex = launch.args.lastIndexOf("--chdir"),
+    index = chdirIndex + 2;
+  assert.ok(
+    chdirIndex > 0 && launch.args[index] === "/run/office-provider/bin/codex",
+    "expected pinned native CLI boundary",
+  );
+  assert.equal(launch.args[0], "bwrap");
+  const assertions = nativeMode
+    ? script.replace("printf 'ephemeral cache' > \"$HOME/.codex/fixture-cache.txt\"\n", "") +
+      `
+python3 - "$5" <<'OFFICE_NETWORK_CANARY'
+import socket,sys
+try:
+    connection=socket.create_connection(("127.0.0.1",int(sys.argv[1])),timeout=1)
+except OSError:
+    print("PASS: native Codex tool sandbox denies host loopback network")
+else:
+    connection.close()
+    raise SystemExit("FAIL: native Codex tool sandbox reached host loopback network")
+OFFICE_NETWORK_CANARY
+`
+    : script;
+  const execIndex = launch.args.lastIndexOf("exec");
+  assert.ok(execIndex > index, "native CLI args must end in exec --json before replacement");
+  // Official0.167 standalone sandbox defaults read-only unless sandbox_mode is an explicit -c override.
+  // Preserve all worker flags and explicitly select the SAME phase policy for this diagnostic subcommand.
+  // Source: rust-v0.167.0/codex-rs/cli/src/debug_sandbox.rs load_debug_sandbox_config_with_codex_home.
+  // Never exec a model prompt, login, or use real auth.
+  const command = nativeMode
+    ? [
+        ...launch.args.slice(1, index + 1),
+        ...launch.args.slice(index + 1, execIndex),
+        "sandbox",
+        "-c",
+        `sandbox_mode=${JSON.stringify(launch.policy.phase === "product" ? "read-only" : "workspace-write")}`,
+        "--",
+      ]
+    : launch.args.slice(1, index);
+  const result = spawnSync(
+    launch.args[0],
+    [
+      ...command,
+      "/bin/sh",
+      "-c",
+      assertions,
+      "office-fixture-smoke",
+      source,
+      cwd,
+      otherProject,
+      wrapper,
+      String(canaryPort),
+    ],
+    { cwd, env: officeWorkerEnvironment(process.env), encoding: "utf8", timeout: 15000 },
+  );
+  if (result.error || result.status !== 0) {
+    // Fixed shell probe has no credentials; do not emit raw environment or backend configuration.
+    throw new Error(
+      `office_os_containment_failed: exit=${result.status ?? "none"}, spawn=${result.error?.name ?? "none"}; ${String(result.stderr ?? "").slice(0, 600)}`,
+    );
+  }
+  process.stdout.write(result.stdout);
+}
+try {
+  fs.mkdirSync(source, { recursive: true });
+  fs.mkdirSync(otherProject, { recursive: true });
+  fs.mkdirSync(path.join(fakeProviderHome, ".codex"), { recursive: true });
+  fs.writeFileSync(
+    path.join(fakeProviderHome, ".codex", "auth.json"),
+    JSON.stringify({
+      auth_mode: "chatgpt",
+      OPENAI_API_KEY: null,
+      tokens: { access_token: "fixture-not-credential", refresh_token: "fixture-not-credential" },
+    }),
+    { mode: 0o600 },
+  );
+  fs.writeFileSync(path.join(wrapper, "HANDOFF.md"), "Fixture approval only; never a real user approval or task.");
+  fs.writeFileSync(path.join(otherProject, "other-project-sentinel.txt"), "must remain invisible");
+  fs.writeFileSync(path.join(source, "README.md"), "fixture source");
+  git("init", "-b", "main");
+  git("config", "user.name", "Fixture");
+  git("config", "user.email", "fixture@example.test");
+  git("add", ".");
+  git("commit", "-m", "fixture baseline");
+  database.exec(`CREATE TABLE projects (id TEXT PRIMARY KEY, project_path TEXT, core_goal TEXT);
+    CREATE TABLE agents (id TEXT PRIMARY KEY, department_id TEXT, role TEXT, cli_provider TEXT);
+    CREATE TABLE tasks (id TEXT PRIMARY KEY,title TEXT,description TEXT,task_type TEXT,assigned_agent_id TEXT,project_id TEXT,project_path TEXT,department_id TEXT,workflow_pack_key TEXT,base_branch TEXT);`);
+  database.prepare("INSERT INTO projects VALUES ('fixture-project', ?, 'isolated fixture')").run(wrapper);
+  database.exec("INSERT INTO agents VALUES ('fixture-agent','planning','team_leader','codex')");
+  if (nativeMode) {
+    if (!configuredRunner.bundle || !configuredRunner.hash)
+      throw new Error("native smoke requires configured bundle path and SHA256");
+    process.env.AI_OFFICE_CODEX_BUNDLE_DIR = configuredRunner.bundle;
+    process.env.AI_OFFICE_CODEX_SHA256 = configuredRunner.hash;
+    if (configuredRunner.root) process.env.AI_OFFICE_PROVIDER_BIN_ROOT = configuredRunner.root;
+    await new Promise<void>((resolve) => canary.listen(0, "127.0.0.1", resolve));
+    canaryPort = (canary.address() as net.AddressInfo).port;
+  } else {
+    const bundle = path.join(temporary, "provider-bin", "bundle"),
+      binary = path.join(bundle, "bin", "codex");
+    fs.mkdirSync(path.dirname(binary), { recursive: true });
+    fs.copyFileSync("/bin/true", binary);
+    fs.chmodSync(binary, 0o755);
+    process.env.AI_OFFICE_CODEX_BUNDLE_DIR = bundle;
+    process.env.AI_OFFICE_CODEX_SHA256 = createHash("sha256").update(fs.readFileSync(binary)).digest("hex");
+    process.env.AI_OFFICE_PROVIDER_BIN_ROOT = path.join(temporary, "provider-bin");
+  }
+  process.env.AI_OFFICE_DEVELOPMENT_ENABLED = "true";
+  process.env.AI_OFFICE_POLICY_ENABLED = "true";
+  process.env.AI_OFFICE_WORKERS_ENABLED = "true";
+  process.env.AI_OFFICE_PROJECTS_ROOT = projects;
+  process.env.AI_OFFICE_PROVIDER_AUTH_DIR = fakeProviderHome;
+  configureOfficePolicy(database);
+  const productTask = "product-fixture-task",
+    developmentTask = "develop-fixture-task";
+  addTask(productTask, "product");
+  runProbe(productTask, source, readOnlyScript);
+  if (!productOnly) {
+    addTask(developmentTask, "development");
+    const working = path.join(source, ".climpire-worktrees", developmentTask.slice(0, 8));
+    fs.mkdirSync(path.dirname(working));
+    git("worktree", "add", "-b", "fixture-development", working);
+    runProbe(developmentTask, working, developmentScript);
+    assert.equal(fs.readFileSync(path.join(working, "approved-worker-output.txt"), "utf8"), "approved fixture edit");
+    assert.equal(fs.existsSync(path.join(source, "must-not-write.txt")), false);
+    assert.equal(fs.existsSync(path.join(source, ".git", "must-not-write.txt")), false);
+  }
+  console.log(
+    productOnly
+      ? "PASS: product-only office sandbox verified; development not tested in this invocation"
+      : "PASS: exact product and development office sandbox verified without model calls or real office state",
+  );
+} catch (error: any) {
+  console.error(`FAIL: ${error.code || error.message || "office sandbox smoke failed"}`);
+  process.exitCode = 1;
+} finally {
+  canary.close();
+  database.close();
+  for (const key of envKeys) {
+    if (previous[key] === undefined) delete process.env[key];
+    else process.env[key] = previous[key];
+  }
+  fs.rmSync(temporary, { recursive: true, force: true });
+}
