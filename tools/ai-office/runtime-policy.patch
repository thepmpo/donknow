+  gate.source = path.join(dir, "source");
+  fs.mkdirSync(gate.source);
+  gate.enabled = true;
+  gate.blocked = false;
+  gate.phase = "product";
+  git("init");
+  git("config", "user.name", "Fixture");
+  git("config", "user.email", "fixture@example.test");
