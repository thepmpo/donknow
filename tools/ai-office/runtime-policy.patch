+const stubs = vi.hoisted(() => ({ spawn: vi.fn(), claim: vi.fn(), finish: vi.fn(), sandbox: vi.fn() }));
+vi.mock("node:child_process", async (original) => ({
+  ...(await original<typeof import("node:child_process")>()),
+  spawn: stubs.spawn,
+}));
+vi.mock("./office-policy.ts", async (original) => ({
+  ...(await original<typeof import("./office-policy.ts")>()),
+  officePolicyEnabled: () => true,
+  officeSandboxCommand: stubs.sandbox,
+  claimOfficeTask: stubs.claim,
+  finishOfficeTask: stubs.finish,
+}));
+import { createCliRuntimeTools } from "./modules/workflow/agents/cli-runtime.ts";
+let dir: string;
+beforeEach(() => {
+  vi.clearAllMocks();
+  dir = fs.mkdtempSync(path.join(os.tmpdir(), "office-launch-"));
+  vi.spyOn(fs, "createWriteStream").mockImplementation(() => new PassThrough() as any);
+  stubs.sandbox.mockReturnValue({
+    args: ["bwrap", "--ro-bind", "source", "source", "codex", "exec", "--json"],
+    policy: { digest: "bound-fixture-digest" },
+  });
+});
+afterEach(() => {
+  vi.restoreAllMocks();
+  fs.rmSync(dir, { recursive: true, force: true });
+});
+const runtime = () =>
+  createCliRuntimeTools({
+    logsDir: dir,
+    clearCliOutputDedup: vi.fn(),
+    buildAgentArgs: () => {
+      throw Error("unsafe generic builder called");
+    },
+    activeProcesses: new Map(),
+    normalizeStreamChunk: (v: Buffer) => v.toString(),
+    shouldSkipDuplicateCliOutput: () => false,
+    broadcast: vi.fn(),
+    TASK_RUN_IDLE_TIMEOUT_MS: 0,
+    TASK_RUN_HARD_TIMEOUT_MS: 0,
+    appendTaskLog: vi.fn(),
+    createSubtaskFromCli: vi.fn(),
+    completeSubtaskFromCli: vi.fn(),
+  } as any);
+function child() {
+  return Object.assign(new EventEmitter(), {
+    pid: 12345,
+    stdin: new PassThrough(),
+    stdout: new PassThrough(),
+    stderr: new PassThrough(),
+    unref: vi.fn(),
+    kill: vi.fn(),
+  });
+}
+describe("final task spawn approval boundary without actual workers", () => {
+  it("claims once before sandbox process spawn, sanitizes secrets and consumes on close", () => {
+    const proc = child();
+    stubs.spawn.mockReturnValue(proc);
+    vi.stubEnv("API_AUTH_TOKEN", "private-office-fixture");
+    vi.stubEnv("OPENAI_API_KEY", "private-provider-fixture");
+    runtime().spawnCliAgent("task-001", "codex", "review only", dir, path.join(dir, "run.log"));
+    expect(stubs.claim).toHaveBeenCalledExactlyOnceWith("task-001", "bound-fixture-digest");
+    expect(stubs.claim.mock.invocationCallOrder[0]).toBeLessThan(stubs.spawn.mock.invocationCallOrder[0]);
+    const [command, , options] = stubs.spawn.mock.calls[0];
