+function fixture() {
+  const db = new DatabaseSync(":memory:");
+  db.exec(
+    "CREATE TABLE tasks(id TEXT,status TEXT,result TEXT,updated_at INTEGER);CREATE TABLE agents(id TEXT,status TEXT,current_task_id TEXT);INSERT INTO tasks VALUES('t1','in_progress',NULL,0);INSERT INTO agents VALUES('a1','working','t1')",
+  );
+  return {
+    db,
+    taskId: "t1",
+    task: { assigned_agent_id: "a1" },
+    exitCode: 0,
+    raw:
+      JSON.stringify({
+        type: "item.completed",
+        item: { type: "agent_message", text: "Evidence-based product review" },
+      }) +
+      "\n" +
+      JSON.stringify({ type: "turn.completed" }),
+    now: 42,
+    broadcast: vi.fn(),
+    appendTaskLog: vi.fn(),
+    clearTaskWorkflowState: vi.fn(),
+  };
+}
+describe("office report waits for a human without automatic follow-on work", () => {
+  it("extracts complete assistant output instead of the old last2000characters", () => {
+    const report = "근거".repeat(5000);
+    expect(
+      extractOfficeReport(
+        "run header\n" +
+          JSON.stringify({ type: "item.completed", item: { type: "agent_message", text: report } }) +
+          "\n" +
+          JSON.stringify({ type: "turn.completed" }),
+      ),
+    ).toBe(report);
+    expect(extractOfficeReport("stderr only")).toBeNull();
+  });
+  it("does not confirm partial output or a failed turn", () => {
+    const event = JSON.stringify({ type: "item.completed", item: { type: "agent_message", text: "partial" } });
+    expect(extractOfficeReport(event)).toBeNull();
+    expect(
+      extractOfficeReport(
+        event + "\n" + JSON.stringify({ type: "turn.completed" }) + "\n" + JSON.stringify({ type: "turn.failed" }),
+      ),
+    ).toBeNull();
+  });
+  it("success becomes review with idle agent and preserved full report", () => {
+    const f = fixture();
+    try {
+      settleOfficeReview(f);
+      expect(f.db.prepare("SELECT status,result FROM tasks").get()).toEqual({
+        status: "review",
+        result: "Evidence-based product review",
+      });
+      expect(f.db.prepare("SELECT status,current_task_id FROM agents").get()).toEqual({
+        status: "idle",
+        current_task_id: null,
+      });
+      expect(f.clearTaskWorkflowState).toHaveBeenCalledExactlyOnceWith("t1");
+    } finally {
+      f.db.close();
+    }
+  });
+  it("process failure or missing final report stays pending without success/autoretry", () => {
+    for (const patch of [{ exitCode: 1 }, { raw: "no final assistant output" }]) {
+      const f = fixture();
+      try {
+        settleOfficeReview({ ...f, ...patch });
+        expect(f.db.prepare("SELECT status FROM tasks").get()).toEqual({ status: "pending" });
+      } finally {
+        f.db.close();
+      }
+    }
+  });
+  it("late close does not overwrite stopped tasks or another current assignment", () => {
+    const f = fixture();
+    try {
+      f.db.exec("UPDATE tasks SET status='cancelled';UPDATE agents SET current_task_id='other-task'");
+      settleOfficeReview(f);
+      expect(f.db.prepare("SELECT status FROM tasks").get()).toEqual({ status: "cancelled" });
+      expect(f.db.prepare("SELECT current_task_id FROM agents").get()).toEqual({ current_task_id: "other-task" });
+      expect(f.broadcast).not.toHaveBeenCalled();
+    } finally {
+      f.db.close();
+    }
+  });
+});
diff --git a/server/office-review-completion.ts b/server/office-review-completion.ts
new file mode 100644
index 0000000..6b5db33
--- /dev/null
+++ b/server/office-review-completion.ts
@@ -0,0 +1,77 @@
+import fs from "node:fs";
+/** Preserve a human-review boundary instead of upstream auto meetings/delegation/merge. */
+export function extractOfficeReport(raw: string): string | null {
+  let report: string | null = null;
+  let complete = false;
+  for (const line of raw.split(/\r?\n/)) {
+    try {
+      const event = JSON.parse(line),
+        item = event.item;
+      if (["turn.started", "turn.failed", "error"].includes(event.type)) complete = false;
+      if (event.type === "turn.completed") complete = !!report;
+      if (
+        event.type === "item.completed" &&
+        item?.type === "agent_message" &&
+        typeof item.text === "string" &&
+        item.text.trim()
+      ) {
+        report = item.text;
+        complete = false;
+      } else if (event.type === "agent_message" && typeof event.message === "string" && event.message.trim()) {
+        report = event.message;
+        complete = false;
+      }
+    } catch {}
+  }
+  return complete ? (report?.slice(-100000) ?? null) : null;
+}
+export function settleOfficeReview({
+  db,
+  taskId,
+  task,
+  exitCode,
+  raw,
+  now,
+  broadcast,
+  appendTaskLog,
+  clearTaskWorkflowState,
+}: any): void {
+  const report = extractOfficeReport(raw),
+    success = exitCode === 0 && !!report;
+  const result =
+    report ??
+    `Office worker report is not confirmed (exit=${exitCode}). Check the task terminal; no automatic retry was started.`;
+  const update = db
+    .prepare("UPDATE tasks SET status=?,result=?,updated_at=? WHERE id=? AND status='in_progress'")
+    .run(success ? "review" : "pending", result, now, taskId);
+  if (!update.changes) return;
+  if (task.assigned_agent_id) {
+    db.prepare("UPDATE agents SET status='idle',current_task_id=NULL WHERE id=? AND current_task_id=?").run(
+      task.assigned_agent_id,
+      taskId,
+    );
+    broadcast("agent_status", db.prepare("SELECT * FROM agents WHERE id=?").get(task.assigned_agent_id));
+  }
+  clearTaskWorkflowState(taskId);
+  appendTaskLog(
+    taskId,
+    "system",
+    success
+      ? "Office report ready for USER review. No automatic meeting, developer delegation, commit, merge or publication."
+      : "Office report not confirmed. Approval was consumed; inspect before explicitly preparing another run.",
+  );
+  broadcast("task_update", db.prepare("SELECT * FROM tasks WHERE id=?").get(taskId));
+}
+
+export function readOfficeLogTail(file: string, maxBytes = 2 * 1024 * 1024): string {
+  const fd = fs.openSync(file, "r");
+  try {
+    const size = fs.fstatSync(fd).size,
+      amount = Math.min(size, maxBytes),
+      buffer = Buffer.alloc(amount);
+    fs.readSync(fd, buffer, 0, amount, size - amount);
+    return buffer.toString("utf8");
+  } finally {
+    fs.closeSync(fd);
+  }
+}
