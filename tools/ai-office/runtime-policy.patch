+    const worktree = lifecycle.createWorktree(dir, "abcdefgh-001", "fixture", "non-existent-unapproved-base");
+    expect(worktree).toContain(".climpire-worktrees/abcdefgh");
+    expect(execFileSync("git", ["-C", worktree!, "rev-parse", "HEAD"], { encoding: "utf8" }).trim()).toBe(gate.head);
