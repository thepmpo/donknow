+  root = fs.mkdtempSync(path.join(os.tmpdir(), "office-knowledge-"));
+  process.env.AI_OFFICE_KNOWLEDGE_ENABLED = "true";
+  const documents = [{path:"product/docs/product.md",sha256:hash("approved product"),bytes:16}];
+  const revision=hash(JSON.stringify(documents)),directory=path.join(root,"knowledge","versions",revision);
+  fs.mkdirSync(path.join(directory,"product","docs"),{recursive:true});
+  fs.writeFileSync(path.join(directory,documents[0].path),"approved product");
+  fs.writeFileSync(path.join(directory,"INDEX.md"),"catalog");
+  fs.writeFileSync(path.join(directory,"manifest.json"),JSON.stringify({revision,documents}));
+  fs.writeFileSync(path.join(root,"knowledge","CURRENT.json"),JSON.stringify({revision}));
+      fs.writeFileSync(path.join(root,"knowledge/HEARTBEAT"),String(Date.now()));
+  return {revision,directory};
+}
+describe("office knowledge",()=>{
+ it("all roles receive a validated revision and document catalog",()=>{const f=fixture();expect(officeKnowledge(root)?.revision).toBe(f.revision);expect(officeKnowledgePrompt(root)).toContain("product/docs/product.md");expect(officeKnowledgePrompt(root)).toContain("not authority");});
+ it("enabled knowledge fails closed when absent or modified",()=>{const f=fixture();fs.writeFileSync(path.join(f.directory,"product/docs/product.md"),"changed");expect(()=>officeKnowledge(root)).toThrow("office_knowledge_not_ready");fs.unlinkSync(path.join(root,"knowledge/CURRENT.json"));expect(()=>officeKnowledge(root)).toThrow();});
+ it("symlinks cannot expose other project documents",()=>{const f=fixture();const file=path.join(f.directory,"product/docs/product.md");fs.unlinkSync(file);fs.symlinkSync("/etc/hosts",file);expect(()=>officeKnowledge(root)).toThrow();});
