+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { execFileSync } from "node:child_process";
+const gate = vi.hoisted(() => ({ enabled: true, blocked: false, source: "", head: "", phase: "product" }));
+vi.mock("./office-policy.ts", () => ({
+  officePolicyEnabled: () => gate.enabled,
+  blockOfficeUnscopedExecution: () => {
+    if (gate.enabled) throw Error("office_unscoped_execution_blocked");
+  },
