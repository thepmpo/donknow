+    expect(options.env.OPENAI_API_KEY).toBeUndefined();
+    proc.emit("close", 0);
+    expect(stubs.finish).toHaveBeenCalledWith("task-001", true);
+    vi.unstubAllEnvs();
+  });
+  it("sandbox rejection never claims a permission or spawns a process", () => {
+    stubs.sandbox.mockImplementation(() => {
+      throw Error("office_os_sandbox_unavailable");
+    });
+    expect(() => runtime().spawnCliAgent("task-001", "codex", "", dir, path.join(dir, "run.log"))).toThrow(
+      "office_os_sandbox_unavailable",
+    );
+    expect(stubs.claim).not.toHaveBeenCalled();
+    expect(stubs.spawn).not.toHaveBeenCalled();
+  });
+  it("synchronous process failure closes the claimed permission and removes debug prompt", () => {
+    stubs.spawn.mockImplementation(() => {
+      throw Error("fixture spawn unavailable");
+    });
+    expect(() => runtime().spawnCliAgent("task-001", "codex", "", dir, path.join(dir, "run.log"))).toThrow(
+      "fixture spawn unavailable",
+    );
+    expect(stubs.finish).toHaveBeenCalledWith("task-001", false);
+    expect(fs.existsSync(path.join(dir, "task-001.prompt.txt"))).toBe(false);
+  });
+});
