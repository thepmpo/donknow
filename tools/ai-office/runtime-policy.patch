+    if (gate.enabled) throw Error("office_unscoped_execution_blocked");
+  },
+  requireOfficeWorker: () => {
+    if (gate.blocked) throw Error("office_approval_required");
+    return { source: gate.source, head: gate.head, phase: gate.phase };
